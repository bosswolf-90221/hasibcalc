# انسخ هذا الملف إلى .env واملأ القيم. كل المتغيرات اختيارية للتطوير المحلي.

# نطاق موقعك النهائي بدون شرطة في النهاية (يُستخدم في canonical وsitemap وOpen Graph). مطلوب قبل النشر.
PUBLIC_SITE_URL=https://www.your-domain.com

# التواصل: بريد يظهر في صفحة اتصل بنا، و/أو رابط نموذج (مثل Formspree: https://formspree.io/f/xxxx)
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_FORM_ENDPOINT=

# Google AdSense — يبقى معطلاً حتى تضع true ومعرّفاً حقيقياً (ca-pub-XXXXXXXXXXXXXXXX). لا يعمل في وضع التطوير.
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT_ID=
PUBLIC_ADSENSE_SLOT_AFTER_CALC=

# اختياري: رمز التحقق من Google Search Console (قيمة content فقط)، ومعرف Google Analytics 4
PUBLIC_GSC_VERIFICATION=
PUBLIC_GA4_ID=
