---
import { ICONS } from '../data/icons';
export interface Props { name: string; size?: number; class?: string }
const { name, size = 22, class: cls = '' } = Astro.props;
---
<svg class={`icon ${cls}`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[name] ?? ''} />
