---
// Calculator card used on the home page, category pages and in "related".
import Icon from './Icon.astro';
import type { CalculatorMeta } from '../data/calculators';
import { CATEGORIES } from '../data/calculators';
export interface Props { c: CalculatorMeta; compact?: boolean }
const { c, compact = false } = Astro.props;
const cat = CATEGORIES.find((x) => x.key === c.categories[0])!;
---
<a class={`ccard ${compact ? 'compact' : ''}`} href={`/${c.slug}/`} data-cat={cat.key}>
  <span class="tile"><Icon name={c.slug} size={compact ? 20 : 24} /></span>
  <span class="body">
    <span class="t">{c.question}</span>
    {!compact && <span class="d">{c.description}</span>}
    {compact ? <span class="k">{c.short}</span> : <span class="go">احسب الآن <Icon name="arrow" size={16} /></span>}
  </span>
</a>
