---
// Frequently asked questions: visible <details> list + FAQPage structured data for Google.
// Answers are our own trusted HTML (may include a link); the JSON-LD gets the plain text.
export interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'أسئلة شائعة' } = Astro.props;
const plain = (h: string) => h.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: plain(i.a) } })) };
---
<div class="faq">
  <h2>{title}</h2>
  {items.map((i) => <details><summary>{i.q}</summary><p set:html={i.a} /></details>)}
</div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
