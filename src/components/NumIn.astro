---
// A labelled number field. type="text" + inputmode lets people type Arabic digits and thousands separators.
export interface Props { name: string; label: string; value: string | number; placeholder?: string; suffix?: string; hint?: string }
const { name, label, value, placeholder = '', suffix, hint } = Astro.props;
const id = `f-${name}`;
---
<div class="field">
  <label for={id}>{label}</label>
  <input class="in" id={id} name={name} data-field={name} data-default={String(value)} type="text" inputmode="decimal"
    autocomplete="off" spellcheck="false" value={String(value)} placeholder={placeholder} aria-describedby={`${id}-err`} />
  {suffix && <span class="field-unit">{suffix}</span>}
  {hint && <small>{hint}</small>}
  <span class="field-error" id={`${id}-err`} hidden></span>
</div>
