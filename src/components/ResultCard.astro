---
// The answer: the most prominent thing on the page, then the details, the actions and how it was computed.
// `example` marks numbers the visitor did not type; the mark goes away with the first edit.
import type { View } from '../lib/views';
import { fmt, odo } from '../lib/format';
export interface Props { view: View; notes?: string[]; shareable?: boolean; sensitive?: boolean; uid?: string; small?: boolean; mini?: boolean; more?: string; example?: boolean }
const { view, notes = [], shareable = true, sensitive = false, uid = 'r', small = false, mini = false, more, example = true } = Astro.props;
const ready = view.value !== null && !view.error;
---
<section class={`result ${small ? 'small' : ''} ${mini ? 'mini' : ''}`} data-result data-state={view.error ? 'error' : ready ? 'ok' : 'blank'} aria-labelledby={`${uid}-title`}>
  <p class="example-flag" data-example hidden={!example || !ready}>مثال توضيحي: غيّر الأرقام لتحسب حالتك.</p>
  <p class="r-error" role="alert" data-r="error" hidden={!view.error}>{view.error}</p>
  <div class="display">
    <div class="r-head">
      <p class="r-label" id={`${uid}-title`} data-r="label">{view.label}</p>
      <span class="r-badge" data-r="badge" hidden={!view.badge}>{view.badge}</span>
    </div>
    <p class="r-value"><span class="v odo" data-r="value" data-decimals={view.decimals} set:html={odo(fmt(view.value, view.decimals))} /><span class="u" data-r="unit">{view.unit}</span></p>
    <slot name="display" />
    <p class="r-sentence" data-r="sentence">{view.sentence}</p>
  </div>
  <dl class="rows" data-r="rows" hidden={mini}>
    {view.rows.map(([k, v]) => <div><dt>{k}</dt><dd class={/[؀-ۿ]/.test(v) ? undefined : 'num'}>{v}</dd></div>)}
  </dl>
  <div class="whatif" data-r="whatif-box" hidden={mini || !view.whatif?.length}>
    <p class="wi-h">ماذا لو؟</p>
    <ul data-r="whatif">{(view.whatif ?? []).map((w) => <li>{w}</li>)}</ul>
  </div>
  <div class="result-actions">
    <button class="btn" type="button" data-act="copy" data-needs-result hidden={!ready}>انسخ النتيجة</button>
    {shareable && !mini && <button class="btn" type="button" data-act="whatsapp" data-needs-result hidden={!ready} data-sensitive={sensitive ? 'true' : undefined}>شارك على واتساب</button>}
    {!mini && <button class="btn" type="button" data-act="print" data-needs-result hidden={!ready}>اطبع</button>}
    <button class="btn" type="button" data-act="reset">ابدأ من جديد</button>
    {more && <a class="btn btn-primary" href={more}>التفاصيل والشرح</a>}
    <span class="toast" role="status" data-r="toast"></span>
  </div>
  {shareable && !mini && (
    <p class="share-links">
      <button class="text-btn" type="button" data-act="share-clean">انسخ رابط الحاسبة</button>
      <button class="text-btn" type="button" data-act="share-values" data-needs-result hidden={!ready} data-sensitive={sensitive ? 'true' : undefined}>انسخ الرابط مع أرقامي</button>
    </p>
  )}
  <p class="from-url" data-r="from-url" hidden>عبّأنا الأرقام من الرابط الذي فتحته. <button class="text-btn" type="button" data-act="clear-url">احذف أرقامي من الرابط</button></p>
  {!mini && (
    <details class="how">
      <summary>كيف حسبناها؟</summary>
      <div class="how-body">
        <slot name="formula" />
        {notes.length > 0 && <ul class="how-notes">{notes.map((n) => <li>{n}</li>)}</ul>}
      </div>
    </details>
  )}
  <p class="sr-only" role="status" aria-atomic="true" data-r="live"></p>
</section>
