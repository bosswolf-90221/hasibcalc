---
// Salary-day countdown: the sentence, the result and the 12-month table. Pages pass their country's defaults.
import NumIn from './NumIn.astro';
import Pills from './Pills.astro';
import AddToCalendar from './AddToCalendar.astro';
import ResultCard from './ResultCard.astro';
import { calcPayday, type ShiftRule, type Weekend } from '../lib/calc/payday';
import { paydayView } from '../lib/views-extra';
import { errorView } from '../lib/views';
import { paydayTable } from '../lib/exhibits-extra';
import { toISODate } from '../lib/calc/core';
export interface Props { payDay: number; weekend: Weekend; rule: ShiftRule; hint?: string; example?: boolean }
const { payDay, weekend, rule, hint = 'إذا كان راتبك في آخر الشهر فاكتب 31، ونحسبه في آخر يوم من كل شهر.', example = true } = Astro.props;
const d = { payDay, weekend, rule };
const r = calcPayday({ ...d, onDate: toISODate(new Date()) });
const view = r.ok ? paydayView(r.value, d.payDay) : errorView(r, 'باقي على الراتب')!;
---
  <div data-calc="salary-day">
    <div class="calc-input">
      <h2 class="input-title">بياناتك</h2>
      <form class="calc-fields" onsubmit="return false" aria-label="موعد الراتب">
        <NumIn name="payDay" label="يوم الراتب في الشهر الميلادي" value={d.payDay} />
        <Pills name="weekend" legend="عطلة نهاية الأسبوع" selected={d.weekend} options={[{ value: 'fri-sat', label: 'الجمعة والسبت' }, { value: 'sat-sun', label: 'السبت والأحد' }]} />
        <Pills name="rule" legend="إذا وافق يوم الراتب العطلة" selected={d.rule} options={[{ value: 'nearest', label: 'ينتقل لأقرب يوم عمل' }, { value: 'before', label: 'يُقدَّم' }, { value: 'after', label: 'يُؤخَّر' }, { value: 'none', label: 'لا يتغير' }]} />
      </form>
      <p class="hint">{hint}</p>
    </div>
    <ResultCard example={example} view={view} notes={['العطل الرسمية والأعياد لا تُحسب، لأن الجهات قد تعلن تقديم الرواتب قبلها بإعلان خاص.', 'التاريخ المستخدم هو تاريخ اليوم بحسب جهازك.']}>
      <p class="formula" slot="formula">نأخذ يوم الراتب في الشهر الحالي، وإن مضى نأخذ الشهر التالي. إذا وافق الجمعة أو السبت (أو السبت أو الأحد) ننقله بحسب اختيارك: إلى يوم العمل قبله، أو بعده، أو أقرب يوم عمل. وأقرب يوم عمل مع عطلة الجمعة والسبت يعني أن الجمعة تنتقل إلى الخميس والسبت إلى الأحد، وهي قاعدة وزارة المالية السعودية للرواتب الحكومية.</p>
    </ResultCard>
    <AddToCalendar title="يوم الراتب" dates={r.ok ? r.value.upcoming.map((u) => u.actual) : []} details="موعد الراتب المتوقع (قد ينتقل بسبب العطلة). المصدر: hasibcalc.com/salary-day/" file="salary-days" label="أضف مواعيد راتبك (12 شهراً) إلى تقويمك" />
    <section class="exhibit" aria-labelledby="x-t">
      <h2 id="x-t" class="exhibit-title">مواعيد رواتبك في الأشهر القادمة</h2>
      <div data-x="table" set:html={paydayTable(r.ok ? r.value : null)} />
    </section>
  </div>


<script>
  import { mountCalculator, num } from '../scripts/runtime';
  import { calcPayday, type ShiftRule, type Weekend } from '../lib/calc/payday';
  import { paydayView } from '../lib/views-extra';
  import { paydayTable } from '../lib/exhibits-extra';
  import { localTodayISO } from '../lib/calc/core';
  const root = document.querySelector<HTMLElement>('[data-calc="salary-day"]')!;
  mountCalculator(root, {
    compute: (f) => {
      const payDay = num(f.payDay);
      const result = calcPayday({ payDay, weekend: f.weekend as Weekend, rule: f.rule as ShiftRule, onDate: localTodayISO() });
      return { result, view: result.ok ? paydayView(result.value, payDay ?? 0) : null };
    },
    extras: (p) => {
      root.querySelector<HTMLElement>('[data-x="table"]')!.innerHTML = paydayTable(p);
      const cal = root.querySelector<HTMLElement>('[data-cal]');
      if (cal) cal.dataset.dates = p.upcoming.map((u) => u.actual).join(',');
    },
  });
</script>
