---
import { ADS } from '../config/site';
export interface Props { position: keyof typeof ADS.slots }
const { position } = Astro.props;
const id = ADS.slots[position];
const dev = import.meta.env.DEV;
---
{ADS.enabled && id ? (
  <aside class="ad-slot" aria-label="إعلان">
    <span class="ad-label">إعلان</span>
    <ins class="adsbygoogle" style="display:block;min-height:250px" data-ad-client={ADS.client} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
) : dev ? (
  <aside class="ad-slot dev" aria-hidden="true">موضع إعلان ({position}) — غير مفعّل في التطوير</aside>
) : null}
