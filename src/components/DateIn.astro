---
export interface Props { name: string; label: string; value: string; max?: string; hint?: string }
const { name, label, value, max, hint } = Astro.props;
const id = `f-${name}`;
---
<div class="field">
  <label for={id}>{label}</label>
  <input class="in" id={id} name={name} data-field={name} data-default={value} type="date" value={value} max={max} aria-describedby={`${id}-err`} />
  {hint && <small>{hint}</small>}
  <span class="field-error" id={`${id}-err`} hidden></span>
</div>
