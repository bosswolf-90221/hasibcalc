---
import '@fontsource/readex-pro/300.css';
import '@fontsource/readex-pro/400.css';
import '@fontsource/readex-pro/500.css';
import '@fontsource/readex-pro/600.css';
import '../styles/global.css';
import ar300 from '@fontsource/readex-pro/files/readex-pro-arabic-300-normal.woff2?url';
import ar600 from '@fontsource/readex-pro/files/readex-pro-arabic-600-normal.woff2?url';
import la600 from '@fontsource/readex-pro/files/readex-pro-latin-600-normal.woff2?url';
import { SITE, ADS, ANALYTICS } from '../config/site';
import { CALCULATORS, CATEGORIES } from '../data/calculators';

export interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/vat/"
  bare?: boolean; // page draws its own container
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  image?: string; // social preview, site-relative
}
const { title, description, path, bare = false, noindex = false, jsonLd = [], image = '/og.png' } = Astro.props;
const canonical = SITE.url + path;
const fullTitle = path === '/' ? title : `${title} | ${SITE.name}`;
const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url + '/', inLanguage: 'ar' }, ...jsonLd];
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#06291f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {[ar300, ar600, la600].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE.url + image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {ANALYTICS.searchConsoleToken && <meta name="google-site-verification" content={ANALYTICS.searchConsoleToken} />}
    <meta name="msvalidate.01" content="E0CD9B525F8D327D4B8FF7032845D07F" />
    {ADS.enabled && <meta name="google-adsense-account" content={ADS.client} />}
    {ADS.enabled && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`} crossorigin="anonymous"></script>}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <div class="read-progress" aria-hidden="true"></div>
    <a class="skip" href="#main">انتقل إلى المحتوى</a>
    <header class="site-head">
      <div class="container topnav">
        <a class="logo" href="/" aria-label="حاسِب، الصفحة الرئيسية"><span class="k" aria-hidden="true"><span></span><span></span><span></span><span></span></span>{SITE.name}</a>
        <nav aria-label="روابط رئيسية">
          <a href="/#index">كل الحاسبات</a>
          {CATEGORIES.slice(0, 2).map((c) => <a href={`/category/${c.key}/`} aria-current={path === `/category/${c.key}/` ? 'page' : undefined}>{c.name}</a>)}
          <a href="/guides/" aria-current={path.startsWith('/guides/') ? 'page' : undefined}>أدلة</a>
          <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>كيف نحسب</a>
        </nav>
        <button class="topsearch" type="button" data-open-finder aria-haspopup="dialog" aria-controls="finder" aria-label="ابحث عن حاسبة">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <span aria-hidden="true">ابحث عن حاسبة</span><kbd aria-hidden="true">/</kbd>
        </button>
      </div>
    </header>

    <dialog id="finder" class="finder" aria-label="ابحث عن حاسبة">
      <div class="finder-box" role="search">
        <div class="find-row">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <label for="q" class="sr-only">ابحث عن حاسبة</label>
          <input id="q" type="search" placeholder="نهاية الخدمة، ضريبة، قسط سيارة…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" />
          <button type="button" class="find-close" data-close-finder aria-label="إغلاق">Esc</button>
        </div>
        <ul id="search-results" class="find-results" role="listbox" hidden></ul>
        <p class="find-empty" hidden>لا توجد حاسبة بهذا الاسم بعد. جرّب <a href="/end-of-service/">نهاية الخدمة</a> أو <a href="/loan/">القسط الشهري</a>، أو <a href="/contact/">اقترح حاسبة</a>.</p>
        <ul class="find-all">{CALCULATORS.map((c) => <li><a href={`/${c.slug}/`}><i style={`background:${c.tone}`} aria-hidden="true"></i>{c.question}</a></li>)}</ul>
      </div>
    </dialog>

    <main id="main">
      {bare ? <slot /> : (
        <>
          <div class="stage page-stage"><div class="container"><slot name="stage" /></div></div>
          <div class="container"><div class="doc card article"><slot /></div></div>
        </>
      )}
    </main>

    <footer class="colophon">
      <div class="container">
        <div class="about">
          <a class="logo" href="/"><span class="k" aria-hidden="true"><span></span><span></span><span></span><span></span></span>{SITE.name}</a>
          <p>{SITE.tagline}. حاسبات عربية مجانية، كل نتيجة معها معادلتها ومصدرها.</p>
        </div>
        <nav aria-label="الحاسبات">
          <h2>الحاسبات</h2>
          <ul>{CALCULATORS.map((c) => <li><a href={`/${c.slug}/`}>{c.short}</a></li>)}</ul>
        </nav>
        <nav aria-label="الموقع">
          <h2>الموقع</h2>
          <ul>
            {CATEGORIES.map((c) => <li><a href={`/category/${c.key}/`}>{c.name}</a></li>)}
            <li><a href="/guides/">أدلة</a></li>
            <li><a href="/about/">من نحن وكيف نحسب</a></li>
            <li><a href="/privacy/">سياسة الخصوصية</a></li>
            <li><a href="/terms/">الشروط والأحكام</a></li>
            <li><a href="/contact/">اتصل بنا</a></li>
          </ul>
        </nav>
        <p class="legal">© {new Date().getFullYear()} {SITE.name}. النتائج تقديرية لأغراض المعلومات ولا تُغني عن استشارة مختص.</p>
      </div>
    </footer>
    <button class="to-top" type="button" data-to-top aria-label="العودة إلى أعلى الصفحة"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg></button>
    <script>import '../scripts/interactions';</script>
    <script>
      import { CALCULATORS } from '../data/calculators';
      const dlg = document.querySelector<HTMLDialogElement>('#finder')!;
      const norm = (s: string) =>
        s.toLowerCase()
          .replace(/[ً-ْـ]/g, '')
          .replace(/[أإآ]/g, 'ا').replace(/ى/g, 'ي').replace(/ة/g, 'ه').replace(/ؤ/g, 'و').replace(/ئ/g, 'ي')
          .replace(/[٠-٩]/g, (d) => String('٠١٢٣٤٥٦٧٨٩'.indexOf(d)))
          .trim();
      const items = CALCULATORS.map((c) => ({ c, hay: norm([c.question, c.short, c.blurb, ...c.terms].join(' ')) }));
      const input = dlg.querySelector<HTMLInputElement>('#q')!;
      const list = dlg.querySelector<HTMLUListElement>('#search-results')!;
      const empty = dlg.querySelector<HTMLElement>('.find-empty')!;
      const all = dlg.querySelector<HTMLElement>('.find-all')!;
      let active = -1;
      function setActive(i: number) {
        const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('a'));
        active = links.length ? (i + links.length) % links.length : -1;
        links.forEach((a, j) => a.setAttribute('aria-selected', j === active ? 'true' : 'false'));
      }
      function run() {
        const q = norm(input.value);
        all.hidden = Boolean(q);
        if (!q) { list.hidden = true; empty.hidden = true; input.setAttribute('aria-expanded', 'false'); return; }
        const words = q.split(/\s+/).map((w) => w.replace(/^ال/, '')).filter(Boolean);
        const hits = items.filter((it) => words.every((w) => it.hay.includes(w)));
        list.replaceChildren(...hits.map(({ c }) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `/${c.slug}/`;
          a.setAttribute('role', 'option');
          const t = document.createElement('span'); t.textContent = c.question;
          const k = document.createElement('span'); k.textContent = c.short; k.className = 'k';
          a.append(t, k); li.append(a); return li;
        }));
        list.hidden = hits.length === 0;
        empty.hidden = hits.length !== 0;
        input.setAttribute('aria-expanded', String(hits.length > 0));
        setActive(0);
      }
      const open = (q = '') => { if (!dlg.open) dlg.showModal(); input.value = q; run(); input.focus(); };
      document.querySelectorAll<HTMLElement>('[data-open-finder]').forEach((b) => b.addEventListener('click', () => open(b.dataset.q ?? '')));
      dlg.querySelector('[data-close-finder]')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      input.addEventListener('input', run);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
        else if (e.key === 'Enter') { const a = list.querySelectorAll('a')[Math.max(0, active)]; if (a) location.href = a.getAttribute('href')!; }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && !dlg.open && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement)) { e.preventDefault(); open(); }
      });
    </script>
  </body>
</html>
