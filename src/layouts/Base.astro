---
import '@fontsource/readex-pro/200.css';
import '@fontsource/readex-pro/300.css';
import '@fontsource/readex-pro/400.css';
import '@fontsource/readex-pro/500.css';
import '@fontsource/readex-pro/600.css';
import '../styles/global.css';
import ar300 from '@fontsource/readex-pro/files/readex-pro-arabic-300-normal.woff2?url';
import ar500 from '@fontsource/readex-pro/files/readex-pro-arabic-500-normal.woff2?url';
import la200 from '@fontsource/readex-pro/files/readex-pro-latin-200-normal.woff2?url';
import { SITE, ADS, ANALYTICS } from '../config/site';
import { CALCULATORS, CATEGORIES } from '../data/calculators';

export interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/vat/"
  bare?: boolean; // page draws its own container
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, path, bare = false, noindex = false, jsonLd = [] } = Astro.props;
const canonical = SITE.url + path;
const fullTitle = path === '/' ? title : `${title} | ${SITE.name}`;
const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url + '/', inLanguage: 'ar' }, ...jsonLd];
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f6f8f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111718" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {[ar300, ar500, la200].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE.url + '/og.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    {ANALYTICS.searchConsoleToken && <meta name="google-site-verification" content={ANALYTICS.searchConsoleToken} />}
    {ADS.enabled && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`} crossorigin="anonymous"></script>}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">انتقل إلى المحتوى</a>
    <header class="masthead">
      <div class="container">
        <a class="brand" href="/" aria-label="حاسِب، الصفحة الرئيسية">{SITE.name}<i aria-hidden="true"></i></a>
        <nav aria-label="روابط رئيسية">
          <a class="opt" href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>كيف نحسب</a>
          <a class="all" href="/#index">كل الحاسبات <span aria-hidden="true">←</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      {bare ? <slot /> : <div class="container page-pad"><slot /></div>}
    </main>

    <footer class="colophon">
      <div class="container">
        <div class="about">
          <a class="brand" href="/">{SITE.name}<i aria-hidden="true"></i></a>
          <p>{SITE.tagline}. حاسبات عربية مجانية، كل نتيجة معها معادلتها ومصدرها.</p>
        </div>
        <nav aria-label="الحاسبات">
          <h2>الحاسبات</h2>
          <ul>{CALCULATORS.map((c) => <li><a href={`/${c.slug}/`}>{c.short}</a></li>)}</ul>
        </nav>
        <nav aria-label="الموقع">
          <h2>الموقع</h2>
          <ul>
            {CATEGORIES.map((c) => <li><a href={`/category/${c.key}/`}>{c.name}</a></li>)}
            <li><a href="/about/">من نحن وكيف نحسب</a></li>
            <li><a href="/privacy/">سياسة الخصوصية</a></li>
            <li><a href="/terms/">الشروط والأحكام</a></li>
            <li><a href="/contact/">اتصل بنا</a></li>
          </ul>
        </nav>
        <p class="legal">© {new Date().getFullYear()} {SITE.name}. النتائج تقديرية لأغراض المعلومات ولا تُغني عن استشارة مختص.</p>
      </div>
    </footer>
  </body>
</html>
