---
// Calculator page on the life-moments system: the question, the fields beside the answer, then the explanation.
import '../styles/calc.css';
import Site from './Site.astro';
import AdSlot from '../components/AdSlot.astro';
import MomentIcon from '../components/MomentIcon.astro';
import { bySlug, CALCULATORS, CATEGORIES } from '../data/calculators';
import { SITE } from '../config/site';
import { GUIDES } from '../data/guides';
import { MOMENTS } from '../data/moments';
import { arDate } from '../lib/format';
import { BASIS_LABEL, VERIFICATION } from '../data/verification';

export interface Props { slug: string; lede: string }
const { slug, lede } = Astro.props;
const c = bySlug(slug);
const cat = CATEGORIES.find((x) => x.key === c.categories[0])!;
const path = `/${slug}/`;
const guides = GUIDES.filter((g) => g.calc === slug);
const moment = MOMENTS.find((m) => m.calcs.includes(slug))!;
const check = VERIFICATION[slug] ?? { basis: 'partial' as const };
const edited = c.updated ?? SITE.lastReviewed;
const near = CALCULATORS.filter((x) => x.slug !== slug && x.categories.includes(cat.key) && !c.related.includes(x.slug));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/category/${cat.key}/` },
      { '@type': 'ListItem', position: 3, name: c.short, item: SITE.url + path },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: c.seoTitle,
    url: SITE.url + path,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    inLanguage: 'ar',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'AED' },
  },
];
---
<Site title={c.seoTitle} description={c.description} path={path} jsonLd={jsonLd} image={`/og/${c.slug}.png`}>
  <div class="wrap calc-page" style={`--tint: var(--moment-${moment.tint})`}>
    <nav class="crumbs" aria-label="مسار التنقل">
      <ol><li><a href="/">الرئيسية</a></li><li><a href={`/category/${cat.key}/`}>{cat.name}</a></li><li aria-current="page">{c.short}</li></ol>
    </nav>
    <header class="page-head">
      <h1 class="t-h1">{c.question}</h1>
      <p class="t-lead">{lede}</p>
      <p class="check-line">{BASIS_LABEL[check.basis]}{check.verified && <>: <time datetime={check.verified}>{arDate(check.verified)}</time></>}</p>
    </header>
    <div class="calc-body" id="calc"><slot /></div>
    <AdSlot position="afterCalculator" />
    <div class="calc-lower">
      <article class="article" id="explain">
        <slot name="article" />
        <p class="reviewed">{BASIS_LABEL[check.basis]}{check.verified ? `: ${arDate(check.verified)}` : ''}. وآخر تعديل لنص الصفحة: {arDate(edited)}.</p>
      </article>
      <aside class="calc-aside" aria-label="روابط مرتبطة">
        <a class="moment-link" href={`/moments/${moment.slug}/`}>
          <MomentIcon name={moment.icon} />
          <small>هذه الحاسبة جزء من موقف</small>
          <b>{moment.name}</b>
          <span>{moment.ask}</span>
        </a>
        {guides.length > 0 && (
          <section><h2>أدلة مرتبطة</h2><ul class="linklist">{guides.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul></section>
        )}
        <section id="related"><h2>حاسبات قريبة</h2><ul class="linklist">{c.related.map(bySlug).map((x) => <li><a href={`/${x.slug}/`}>{x.question}</a></li>)}</ul></section>
        {near.length > 0 && (
          <section><h2>{cat.name}</h2><ul class="linklist">{near.map((x) => <li><a href={`/${x.slug}/`}>{x.question}</a></li>)}</ul></section>
        )}
        <p class="more-all"><a class="link" href="/#index">كل الحاسبات</a></p>
      </aside>
    </div>
  </div>
</Site>
