---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import CalcIndex from '../components/CalcIndex.astro';
import Reveal from '../components/motion/Reveal.tsx';
import { bySlug, CALCULATORS, CATEGORIES } from '../data/calculators';
import { SITE } from '../config/site';
import { arDate } from '../lib/format';

export interface Props { slug: string; lede: string }
const { slug, lede } = Astro.props;
const c = bySlug(slug);
const cat = CATEGORIES.find((x) => x.key === c.categories[0])!;
const no = String(CALCULATORS.indexOf(c) + 1).padStart(2, '0');
const total = String(CALCULATORS.length).padStart(2, '0');
const path = `/${slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/category/${cat.key}/` },
      { '@type': 'ListItem', position: 3, name: c.short, item: SITE.url + path },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: c.seoTitle,
    url: SITE.url + path,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    inLanguage: 'ar',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'AED' },
  },
];
---
<Base title={c.seoTitle} description={c.description} path={path} jsonLd={jsonLd} bare>
  <div class="container">
    <header class="calc-head">
      <div class="meta">
        <span class="big nums">{no}<small> / {total}</small></span>
        <a href={`/category/${cat.key}/`}>{cat.name}</a>
        <span>مراجعة {arDate(SITE.lastReviewed)}</span>
      </div>
      <div class="title">
        <nav class="crumbs" aria-label="مسار التنقل">
          <ol><li><a href="/">الرئيسية</a></li><li><a href={`/category/${cat.key}/`}>{cat.name}</a></li><li aria-current="page">{c.short}</li></ol>
        </nav>
        <h1>{c.question}</h1>
        <p class="lede">{lede}</p>
      </div>
    </header>

    <div class="calc-body">
      <aside class="side">
        <div class="side-sticky">
          <div>
            <p class="side-label">في هذه الصفحة</p>
            <ul class="side-toc">
              <li><a href="#calc">الحاسبة</a></li>
              <li><a href="#explain">الشرح والمثال</a></li>
              <li><a href="#related">حاسبات قريبة</a></li>
            </ul>
          </div>
          <div>
            <p class="side-label">الخصوصية</p>
            <p class="side-note">الحساب يتم في متصفحك، ولا نرسل أرقامك إلى أي خادم.</p>
          </div>
        </div>
      </aside>
      <div class="main">
        <div id="calc"><slot /></div>
        <AdSlot position="afterCalculator" />
        <article class="article" id="explain">
          <slot name="article" />
          <p class="reviewed">آخر مراجعة للمعادلة مقابل المصادر المذكورة: {arDate(SITE.lastReviewed)}.</p>
        </article>
        <section class="related" id="related">
          <div class="related-head"><h2>حاسبات قريبة</h2><a href="/#index">كل الحاسبات</a></div>
          <Reveal client:idle selector="li"><CalcIndex items={c.related.map(bySlug)} compact /></Reveal>
        </section>
      </div>
    </div>
  </div>
</Base>
