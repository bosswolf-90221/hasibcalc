---
import Faq from '../components/Faq.astro';
import CalcLayout from '../layouts/CalcLayout.astro';
import NumIn from '../components/NumIn.astro';
import Pills from '../components/Pills.astro';
import ResultCard from '../components/ResultCard.astro';
import { calcLoan } from '../lib/calc/loan';
import { loanView, errorView } from '../lib/views';
import { money } from '../lib/format';
import { loanSchedule } from '../lib/exhibits';
import { loanWhatIf } from '../lib/views-extra';

const d = { principal: 100000, annualRatePercent: 4.5, months: 48, method: 'reducing' as const };
const r = calcLoan(d);
const view = r.ok ? { ...loanView(r.value, d.method), whatif: loanWhatIf(d) } : errorView(r, 'قسطك الشهري')!;
const years = r.ok ? r.value.years : [];
const cmpFlat = calcLoan({ principal: 50000, annualRatePercent: 3, months: 36, method: 'flat' });
const cmpRed = calcLoan({ principal: 50000, annualRatePercent: 3, months: 36, method: 'reducing' });
---
<CalcLayout slug="loan" lede="للقرض الشخصي وتمويل السيارة والعقار. اكتب المبلغ والفائدة والمدة، واختر نوع الفائدة كما يذكره البنك.">
  <div data-calc="loan">
    <div class="calc-input">
    <h2 class="input-title">بياناتك</h2>
    <form class="calc-fields" onsubmit="return false" aria-label="بيانات القرض">
        <NumIn name="principal" label="مبلغ القرض" value={d.principal} />
        <NumIn name="annualRatePercent" label="نسبة الفائدة السنوية (%)" value={d.annualRatePercent} />
        <Pills name="method" legend="نوع الفائدة" selected={d.method} options={[{ value: 'reducing', label: 'متناقصة' }, { value: 'flat', label: 'ثابتة' }]} />
        <NumIn name="months" label="مدة القرض بالأشهر" value={d.months} />
      </form>
    <p class="hint">إعلانات تمويل السيارات تذكر الفائدة الثابتة غالباً، وقروض العقار والقروض الشخصية تذكر المتناقصة غالباً. اسأل البنك إن لم تكن متأكداً.</p>
    </div>

    <ResultCard view={view} sensitive notes={[
      'نموذج الفائدة الثابتة هنا مبسّط: الفائدة على كامل المبلغ طوال المدة، موزعة بالتساوي.',
      'رسوم المعالجة والتأمين وتوقيت أول قسط قد تغيّر القسط الحقيقي.',
      'القسط مقرّب للعرض إلى خانتين، والجدول محسوب بالدقة الكاملة.',
    ]}>
      <p class="formula" slot="formula">المتناقصة: <code>القسط = P × r ÷ (1 − (1 + r)^−n)</code> حيث r الفائدة السنوية ÷ 12.<br />الثابتة: <code>القسط = (P + P × الفائدة × n ÷ 12) ÷ n</code></p>
    </ResultCard>

    <section class="exhibit" aria-labelledby="sched-title">
      <h2 id="sched-title" class="exhibit-title">جدول السداد سنة بسنة</h2>
      <div data-x="sched" set:html={loanSchedule(years)} />
    </section>
  </div>

  <Fragment slot="article">
    <h2>الفائدة الثابتة أم المتناقصة؟</h2>
    <p>في <strong>المتناقصة</strong> تُحسب الفائدة كل شهر على الرصيد المتبقي فقط، فتقل مع كل قسط. في <strong>الثابتة</strong> تُحسب على كامل مبلغ القرض طوال المدة، لذلك تبدو نسبتها أقل في الإعلان لكن تكلفتها الفعلية أعلى.</p>
    <div class="example">
      <p>قرض 50,000 لمدة 36 شهراً بنسبة 3%: بالفائدة الثابتة تدفع فوائد <strong class="num">{cmpFlat.ok ? money(cmpFlat.value.totalInterest) : ''}</strong>، وبالمتناقصة <strong class="num">{cmpRed.ok ? money(cmpRed.value.totalInterest) : ''}</strong>. الفرق كله من طريقة الحساب وليس من النسبة.</p>
    </div>
    <h2>أخطاء شائعة</h2>
    <ul>
      <li>مقارنة عرضين أحدهما بفائدة ثابتة والآخر بمتناقصة بالنسبة المعلنة وحدها.</li>
      <li>نسيان رسوم المعالجة والتأمين عند حساب التكلفة الكلية.</li>
    </ul>
    <h2>متى لا تنطبق هذه النتيجة؟</h2>
    <p>عند وجود فترة سماح، أو فائدة متغيرة تتبع مؤشراً مثل إيبور، أو دفعة أخيرة كبيرة، أو تمويل إسلامي بهامش ربح بصيغة مختلفة. اطلب من البنك جدول السداد الرسمي ومعدل التكلفة السنوي.</p>
    <Faq title="أسئلة شائعة" items={[
      { q: "ماذا لو كانت الفائدة صفراً؟", a: "القسط يساوي المبلغ مقسوماً على عدد الأشهر، والحاسبة تتعامل مع هذه الحالة مباشرة." },
      { q: "هل يقل القسط إذا سددت مبكراً؟", a: "السداد المبكر يقلل الرصيد والفوائد في المتناقصة، وقد يفرض البنك رسوماً عليه. تحقق من عقدك." },
    ]} />
    <h2>المصادر</h2>
    <ul class="sources"><li><a href="https://rulebook.centralbank.ae/en/rulebook/article-6-computation-interest" rel="noopener" target="_blank">دليل قواعد المصرف المركزي الإماراتي: حساب الفائدة بالرصيد المتناقص والإفصاح عن المعدل الفعلي</a></li><li><a href="https://rulebook.centralbank.ae/en/rulebook/consumer-protection-standards" rel="noopener" target="_blank">مصرف الإمارات العربية المتحدة المركزي: معايير حماية المستهلك</a></li></ul>
  </Fragment>
</CalcLayout>


<script>
  import { mountCalculator, num } from '../scripts/runtime';
  import { calcLoan } from '../lib/calc/loan';
  import { loanView } from '../lib/views';
  import { loanSchedule } from '../lib/exhibits';
  import { loanWhatIf } from '../lib/views-extra';
  const root = document.querySelector<HTMLElement>('[data-calc="loan"]')!;
  const sched = root.querySelector<HTMLElement>('[data-x="sched"]')!;
  mountCalculator(root, {
    compute: (f) => {
      const method = f.method === 'flat' ? 'flat' : 'reducing';
      const input = { principal: num(f.principal), annualRatePercent: num(f.annualRatePercent), months: num(f.months), method } as const;
      const result = calcLoan(input);
      return { result, view: result.ok ? { ...loanView(result.value, method), whatif: loanWhatIf(input) } : null };
    },
    extras: (r) => { sched.innerHTML = loanSchedule(r.years); },
  });
</script>
