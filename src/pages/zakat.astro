---
import Faq from '../components/Faq.astro';
import CalcLayout from '../layouts/CalcLayout.astro';
import NumIn from '../components/NumIn.astro';
import Pills from '../components/Pills.astro';
import ResultCard from '../components/ResultCard.astro';
import { calcZakat } from '../lib/calc/zakat';
import { zakatView, errorView } from '../lib/views';
import { zakatLedger } from '../lib/exhibits';

const d = { cash: 60000, investments: 20000, debts: 5000, goldPricePerGram: null };
const r = calcZakat(d);
const view = r.ok ? zakatView(r.value) : errorView(r, 'زكاتك')!;
const below = calcZakat({ cash: 30000, investments: 0, debts: 0, goldPricePerGram: 400 });
const belowV = below.ok ? below.value : null;
const amounts = [50000, 100000, 250000, 500000, 1000000];
const fmt = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 2 });
---
<CalcLayout slug="zakat" lede="حساب مبدئي لزكاة النقد والمدخرات والاستثمارات. اكتب سعر غرام الذهب اليوم كما تجده لدى محل أو مصدر موثوق، لأننا لا نعرض سعراً آنياً.">
  <div data-calc="zakat">
    <div class="calc-input">
    <h2 class="input-title">بياناتك</h2>
    <form class="calc-fields" onsubmit="return false" aria-label="بيانات الزكاة">
        <NumIn name="cash" label="النقد والمدخرات" value={d.cash} />
        <NumIn name="investments" label="الاستثمارات الخاضعة للزكاة" value={d.investments} />
        <NumIn name="debts" label="الديون الحالّة التي تُخصم" value={d.debts} />
        <NumIn name="goldPricePerGram" label="سعر غرام الذهب عيار 24" value="" placeholder="؟" />
        <NumIn name="silverPricePerGram" label="سعر غرام الفضة، يلزم لخيار الأقل من الذهب والفضة" value="" placeholder="؟" />
        <Pills name="basis" legend="أساس النصاب" selected="gold" options={[{ value: 'gold', label: 'الذهب' }, { value: 'lower', label: 'الأقل من الذهب والفضة' }]} />
      </form>
    <p class="hint">اختلفت الجهات في نصاب النقود: مجلس الإمارات للإفتاء الشرعي يعتمد 85 غراماً من الذهب، ودليل هيئة الزكاة السعودية يعتمد الأقل من نصاب الذهب أو الفضة. اكتب المبالغ والأسعار بالعملة نفسها.</p>
    </div>

    <ResultCard view={view} sensitive notes={[
      'تجب الزكاة إذا بلغ المال النصاب وحال عليه الحول الهجري.',
      'لا نرجّح بين قولَي النصاب. إن لم تعرف ما يلزمك فاسأل جهة الإفتاء في بلدك.',
      'طريقة احتساب الأسهم والصناديق والعقارات المعدّة للتجارة والديون تختلف بحسب نوعها، وفيها تفاصيل فقهية.',
      'نخصم ما تكتبه من الديون الحالّة، وفي ذلك خلاف: فدليل هيئة الزكاة السعودية لا يحسم الديون. إن أخذت بقوله فاكتب في الخانة صفراً، واسأل جهة الإفتاء عن حالتك.',
    ]}>
      <p class="formula" slot="formula"><code>الصافي = النقد + الاستثمارات − الديون</code> · <code>نصاب الذهب = 85 × سعر الغرام</code> · <code>نصاب الفضة = 595 × سعر الغرام</code> · <code>الزكاة = الصافي × 2.5%</code></p>
    </ResultCard>

    <section class="exhibit" aria-labelledby="nisab-title">
      <h2 id="nisab-title" class="exhibit-title">دفتر الحساب</h2>
      <div data-x="ledger" set:html={zakatLedger(d.cash, d.investments, d.debts, r.ok ? r.value : null)} />
    </section>
  </div>

  <Fragment slot="article">
    <div class="example">
      <p><strong>الجواب المختصر:</strong> لحساب زكاة المال اجمع النقد والمدخرات والاستثمارات التي تجب فيها الزكاة، واخصم الديون الحالّة، ثم قارن الصافي بالنصاب (قيمة 85 غراماً من الذهب الخالص بسعر اليوم). إذا بلغه وحال عليه حول هجري كامل فالزكاة = الصافي × 2.5%، أي ربع العشر، أو الصافي ÷ 40.</p>
    </div>
    <h2>كيف تُحسب زكاة المال؟</h2>
    <p>زكاة النقود ربع العشر، أي 2.5%، بشرطين: أن يبلغ المال النصاب، وأن يمر عليه حول هجري كامل. والنصاب يعادل قيمة 85 غراماً من الذهب الخالص، ولذلك يتغير بتغير سعر الذهب.</p>
    <div class="example">
      <p>صافي مال 75,000 درهم، وسعر الغرام 400 درهم: النصاب 85 × 400 = 34,000. المال تجاوز النصاب، فالزكاة 75,000 × 2.5% = 1,875 درهماً.</p>
    </div>
    <h2>طريقة حساب زكاة المال خطوة بخطوة</h2>
    <ol>
      <li><strong>اجمع المال:</strong> النقد في البيت والحسابات البنكية والمدخرات، والاستثمارات التي تجب فيها الزكاة.</li>
      <li><strong>اخصم الديون الحالّة:</strong> أي الديون المستحقة عليك الآن، لا الأقساط المؤجلة كلها.</li>
      <li><strong>احسب النصاب:</strong> 85 × سعر غرام الذهب عيار 24 يوم وجوب الزكاة.</li>
      <li><strong>قارن:</strong> إن كان الصافي أقل من النصاب فلا زكاة عليه.</li>
      <li><strong>اضرب في 2.5%:</strong> إن بلغ الصافي النصاب ومرّ عليه حول هجري، فالزكاة = الصافي × 0.025.</li>
    </ol>
    {belowV && belowV.nisab !== null && (
      <div class="example">
        <p>مثال لمال لم يبلغ النصاب: صافي مال {fmt(belowV.net)} درهم وسعر الغرام 400 درهم. النصاب {fmt(belowV.nisab)} درهم، والمال أقل منه، فلا زكاة عليه.</p>
      </div>
    )}
    <h2>كم زكاة المبلغ الذي بلغ النصاب؟</h2>
    <div class="scroll-x">
      <table>
        <thead><tr><th>صافي المال (درهم)</th><th>الزكاة 2.5% (درهم)</th></tr></thead>
        <tbody>
          {amounts.map((a) => <tr><td class="num">{fmt(a)}</td><td class="num">{fmt(a * 0.025)}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p>الجدول يفترض أن المال بلغ النصاب وحال عليه الحول. والنسبة واحدة بأي عملة، فزكاة 100,000 ريال 2,500 ريال.</p>
    <h2>لماذا لا نعرض سعر الذهب تلقائياً؟</h2>
    <p>لأن سعر الذهب يتغير خلال اليوم ويختلف بين المصادر. وعرض رقم غير محدّث قد يعطيك نصاباً خاطئاً، فتكتبه أنت من مصدر تثق به.</p>
    <h2>متى لا تنطبق هذه النتيجة؟</h2>
    <p>الحاسبة لا تحسب زكاة الذهب المدّخر بالوزن، ولا الزروع، ولا الأنعام، ولا عروض التجارة المعقدة. وهي لا تغني عن سؤال جهة إفتاء معتمدة. ولزكاة الذهب بالوزن والعيار مع أمثلة محسوبة، اقرأ <a href="/guides/zakat-step-by-step/">دليل حساب الزكاة خطوة بخطوة</a>.</p>
    <Faq title="أسئلة شائعة" items={[
      { q: "كيف أحسب زكاة المال؟", a: "اجمع النقد والمدخرات والاستثمارات الزكوية، واخصم الديون الحالّة، فإن بلغ الصافي قيمة 85 غراماً من الذهب الخالص وحال عليه حول هجري، فاضربه في 2.5% أو اقسمه على 40." },
      { q: "كم زكاة 100 ألف؟", a: "إذا بلغت النصاب وحال عليها الحول فزكاتها 100,000 × 2.5% = 2,500، بالعملة نفسها." },
      { q: "هل أستخدم نصاب الذهب أم الفضة؟", a: "تعتمد الحاسبة نصاب الذهب في البداية، ويمكنك اختيار «الأقل من الذهب والفضة» بعد كتابة السعرين. بعض العلماء يرون الأخذ بنصاب الفضة لأنه أحظ للفقراء، فيجب الزكاة على مبلغ أقل." },
      { q: "كيف أحسب زكاة الذهب؟", a: "إذا بلغ وزن الذهب المدّخر نصاب عياره (85 غراماً لعيار 24، و97.15 لعيار 21) ومرّ عليه حول قمري، فاضرب الوزن في سعر الغرام يوم الوجوب ثم في 2.5%. أما الحلي المتخذ للبس والزينة فلا زكاة فيه بحسب بيان مجلس الإمارات للإفتاء الشرعي." },
      { q: "متى يبدأ الحول؟", a: "من اليوم الذي بلغ فيه مالك النصاب، وتجب الزكاة بعد مرور سنة هجرية كاملة عليه." },
    ]} />
    <h2>المصادر</h2>
    <ul class="sources">
      <li><a href="https://www.wam.ae/ar/article/b2kivtk-%D8%A7%D9%84%D8%A5%D9%81%D8%AA%D8%A7%D8%A1-%D8%A7%D9%84%D8%B4%D8%B1%D8%B9%D9%8A-%D9%8A%D8%B5%D8%AF%D8%B1-%D8%A8%D9%8A%D8%A7%D9%86%D8%A7-%D9%8A%D9%88%D8%B6%D8%AD-%D9%81%D9%8A%D9%87-%D8%A3%D9%86%D9%88%D8%A7%D8%B9-%D8%B2%D9%83%D8%A7%D8%A9" rel="noopener" target="_blank">وكالة أنباء الإمارات: بيان مجلس الإمارات للإفتاء الشرعي عن الزكاة</a></li>
      <li><a href="https://zatca.gov.sa/ar/HelpCenter/guidelines/Documents/Zakat_Individual.pdf" rel="noopener" target="_blank">هيئة الزكاة والضريبة والجمارك: الدليل الإرشادي لزكاة الأفراد (إرشادي غير ملزم)</a></li>
      <li><a href="https://www.aletihad.ae/news/4477821" rel="noopener" target="_blank">صحيفة الاتحاد: بيان مجلس الإمارات للإفتاء الشرعي حول زكاة النقود (النصاب 85 غراماً من الذهب الخالص)</a></li>
      <li><a href="https://www.emaratalyoum.com/local-section/other/2024-04-09-1.1842420" rel="noopener" target="_blank">الإمارات اليوم: بيان مجلس الإمارات للإفتاء الشرعي عن زكاة الذهب والفضة (النصاب بالعيارات، والحلي المتخذ للزينة)</a></li>
      <li>للفتوى في حالتك: المركز الرسمي للإفتاء في الهيئة العامة للشؤون الإسلامية والأوقاف بالإمارات.</li>
    </ul>
  </Fragment>
</CalcLayout>

<script>
  import { mountCalculator, num } from '../scripts/runtime';
  import { calcZakat } from '../lib/calc/zakat';
  import { zakatView } from '../lib/views';
  import { zakatLedger } from '../lib/exhibits';
  const root = document.querySelector<HTMLElement>('[data-calc="zakat"]')!;
  const x = (k: string) => root.querySelector<HTMLElement>(`[data-x="${k}"]`)!;
  mountCalculator(root, {
    compute: (f) => {
      const gold = f.goldPricePerGram.trim() === '' ? null : num(f.goldPricePerGram);
      const result = calcZakat({
        cash: num(f.cash) ?? 0,
        investments: num(f.investments) ?? 0,
        debts: num(f.debts) ?? 0,
        goldPricePerGram: f.goldPricePerGram.trim() === '' ? null : gold ?? NaN,
        silverPricePerGram: f.silverPricePerGram.trim() === '' ? null : num(f.silverPricePerGram) ?? NaN,
        basis: f.basis === 'lower' ? 'lower' : 'gold',
      });
      return { result, view: result.ok ? zakatView(result.value) : null };
    },
    extras: (z, f) => { x('ledger').innerHTML = zakatLedger(num(f.cash) ?? 0, num(f.investments) ?? 0, num(f.debts) ?? 0, z); },
  });
</script>
