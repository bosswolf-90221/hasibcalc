---
import '../styles/calc.css';
import MomentIcon from '../components/MomentIcon.astro';
import Site from '../layouts/Site.astro';
import { CALCULATORS } from '../data/calculators';
import { MOMENTS } from '../data/moments';
---
<Site title="الصفحة غير موجودة" description="الصفحة التي تبحث عنها غير موجودة في حاسِب. اختر إحدى الحاسبات المتوفرة: نهاية الخدمة، القسط، الضريبة، الزكاة وغيرها." path="/404/" noindex>
  <div class="wrap calc-page">
    <header class="page-head not-found">
      <h1 class="t-h1">هذه الصفحة غير موجودة</h1>
      <p class="t-lead">ربما تغيّر الرابط أو كُتب بشكل خاطئ. ابحث عمّا تريد، أو اختر موقفك.</p>
    </header>
    <form class="search-box" role="search" action="/search/" method="get">
      <label class="sr-only" for="nf-q">ما الذي تبحث عنه؟</label>
      <input class="finder-input" id="nf-q" name="q" type="search" placeholder="قرض، زكاة، موعد الراتب…" autocomplete="off" />
    </form>
    <section class="calc-group" aria-labelledby="nf-m">
      <h2 id="nf-m" class="t-h2">مواقف الحياة</h2>
      <ul class="guide-cards nf-moments">
        {MOMENTS.map((m) => <li style={`--tint: var(--moment-${m.tint})`}><a href={`/moments/${m.slug}/`}><MomentIcon name={m.icon} /><b>{m.name}</b><span>{m.ask}</span></a></li>)}
      </ul>
    </section>
    <section class="calc-group" aria-labelledby="nf-c">
      <h2 id="nf-c" class="t-h2">الحاسبات المتوفرة</h2>
      <ul class="calc-list linklist">{CALCULATORS.map((c) => <li><a href={`/${c.slug}/`}>{c.question}</a></li>)}</ul>
    </section>
  </div>
</Site>
