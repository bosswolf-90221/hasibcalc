---
import { ageDaysTable } from '../lib/exhibits-extra';
import Faq from '../components/Faq.astro';
import CalcLayout from '../layouts/CalcLayout.astro';
import DateIn from '../components/DateIn.astro';
import ResultCard from '../components/ResultCard.astro';
import { calcAge } from '../lib/calc/age';
import { ageView, blankView } from '../lib/views';
import { toISODate } from '../lib/calc/core';

const today = toISODate(new Date());
const d = { birthDate: '' };
const r = calcAge({ birthDate: d.birthDate, onDate: today });
const view = blankView('عمرك');
const a = r.ok ? r.value : null;
---
<CalcLayout slug="age" lede="اختر تاريخ ميلادك، ونحسب عمرك بتاريخ اليوم في جهازك.">
  <div data-calc="age">
    <div class="calc-input">
    <h2 class="input-title">بياناتك</h2>
    <form class="calc-fields" onsubmit="return false" aria-label="تاريخ الميلاد">
        <DateIn name="birthDate" label="تاريخ الميلاد" value={d.birthDate} max={today} />
      </form>
    </div>


    <ResultCard example={false} view={view} notes={['من وُلد في 29 فبراير نعتبر عيد ميلاده 28 فبراير في السنوات غير الكبيسة.', 'التاريخ المستخدم هو تاريخ اليوم بحسب جهازك وتوقيته المحلي.']} />

    <section class="exhibit" hidden aria-labelledby="trio-title"><h2 id="trio-title" class="exhibit-title">عمرك مفصّلاً</h2><div class="trio">
      <div><span class="n num" data-x="y">{a?.years ?? '—'}</span><span class="l">سنة</span></div>
      <div><span class="n num" data-x="m">{a?.months ?? '—'}</span><span class="l">شهر</span></div>
      <div><span class="n num" data-x="d">{a?.days ?? '—'}</span><span class="l">يوم</span></div>
    </div></section>
  </div>

  <Fragment slot="article">
    <h2>كيف يُحسب العمر بدقة؟</h2>
    <p>نحسب السنوات الكاملة منذ يوم الميلاد، ثم الأشهر الكاملة بعد آخر عيد ميلاد، ثم الأيام المتبقية. ولا نقسم الأيام على 365، لأن الأشهر تختلف في طولها، والسنة الكبيسة فيها 366 يوماً.</p>
    <div class="example">
      <p>مولود في 15 يونيو 1995، وتاريخ اليوم 17 أكتوبر 2026: عمره 31 سنة، و4 أشهر، ويومان.</p>
    </div>
    <h2>العمر بالأشهر والأيام والأسابيع</h2>
    <p>الأرقام تقريبية، وتعتمد متوسط السنة 365.2425 يوماً. للحساب الدقيق بتاريخ ميلادك استخدم الحاسبة أعلاه.</p>
    <Fragment set:html={ageDaysTable()} />
    <h2>أمثلة محسوبة بتواريخ مختلفة</h2>
    <div class="scroll-x"><table class="ledger">
      <thead><tr><th>تاريخ الميلاد</th><th>بتاريخ</th><th>العمر</th><th>الأيام الكاملة</th></tr></thead>
      <tbody>
        <tr><td class="nw">10 مارس 1990</td><td class="nw">4 نوفمبر 2026</td><td class="nw">36 سنة و7 أشهر و25 يوماً</td><td class="num">13,388</td></tr>
        <tr><td class="nw">1 سبتمبر 2012</td><td class="nw">31 أغسطس 2026</td><td class="nw">13 سنة و11 شهراً و30 يوماً</td><td class="num">5,112</td></tr>
        <tr><td class="nw">1 سبتمبر 2012</td><td class="nw">1 سبتمبر 2026</td><td class="nw">14 سنة بالضبط</td><td class="num">5,113</td></tr>
        <tr><td class="nw">31 يناير 1985</td><td class="nw">1 مارس 2026</td><td class="nw">41 سنة وشهر ويوم</td><td class="num">15,004</td></tr>
      </tbody>
    </table></div>
    <p>المثال الثاني والثالث يوضحان أن العمر يزيد سنة كاملة في يوم الميلاد نفسه لا قبله بيوم، فمن يسأل عن عمره بتاريخ 31 أغسطس لم يبلغ 14 سنة بعد.</p>

    <h2>مثال: من وُلد في 29 فبراير</h2>
    <div class="example">
      <p>مولود في 29 فبراير 2000. في السنوات غير الكبيسة نعتبر عيد ميلاده 28 فبراير، فبتاريخ 28 فبراير 2027 يكون عمره <strong>27 سنة بالضبط</strong>، وبتاريخ 1 مارس 2027 يكون <strong>27 سنة ويوماً واحداً</strong>. وفي 29 فبراير 2028 يتم 28 سنة بالضبط.</p>
    </div>

    <h2>كم باقي على عيد ميلادك؟</h2>
    <p>تعطيك الحاسبة عدد الأيام الباقية على عيد الميلاد القادم. فمن وُلد في 10 مارس 1990 يبقى له بتاريخ 4 نوفمبر 2026 نحو 126 يوماً حتى عيد ميلاده القادم في 10 مارس 2027.</p>

    <h2>كيف تحسب الفرق في العمر بين شخصين؟</h2>
    <p>احسب عمر كل منهما بتاريخ واحد، أو استخدم <a href="/days-between/">حاسبة الأيام بين تاريخين</a> بين تاريخي ميلادهما. وإن أردت عمرك بالتقويم الهجري فانظر <a href="/hijri-age/">حاسبة العمر بالهجري</a> و<a href="/guides/age-in-hijri/">دليل العمر بالهجري</a>.</p>

    <h2>أساس الحساب</h2>
    <p>الحساب حساب تقويمي على التقويم الميلادي، لا يحتاج إلى معامل أو نسبة تصدرها جهة معينة: السنوات الكاملة، ثم الأشهر الكاملة، ثم الأيام، مع اعتبار السنة الكبيسة التي تقبل القسمة على 4. وإذا طلبت جهة رسمية حساب العمر بطريقة مختلفة (كتاريخ محدد للقبول المدرسي) فاتبع تعليماتها.</p>
    <h2>أخطاء شائعة</h2>
    <ul>
      <li>طرح سنة الميلاد من السنة الحالية فقط، فيزيد العمر سنة قبل عيد الميلاد.</li>
      <li>حساب الأشهر بثلاثين يوماً ثابتة.</li>
    </ul>
    <h2>متى لا تنطبق؟</h2>
    <p>الحاسبة تعتمد التقويم الميلادي. إذا كانت الجهة التي تتعامل معها تحسب العمر بالتقويم الهجري، فالنتيجة ستختلف.</p>
    <Faq title="أسئلة شائعة" items={[
      { q: "كيف أحسب عمري بالأيام؟", a: "تُحسب الأيام الفعلية بين تاريخ ميلادك وتاريخ اليوم. التقدير السريع هو العمر بالسنوات × 365.25، لكن الحاسبة أعلاه تعطيك العدد الدقيق." },
      { q: "كم يوماً عشت إذا وُلدت في 10 مارس 1990؟", a: "13,388 يوماً كاملاً بتاريخ 4 نوفمبر 2026، أي 36 سنة و7 أشهر و25 يوماً." },
      { q: "متى يتم من وُلد في 29 فبراير سنة جديدة؟", a: "نعتبر عيد ميلاده 28 فبراير في السنوات غير الكبيسة، ويتم السنة في 29 فبراير في السنوات الكبيسة." },
      { q: "هل أحسب عمري بالأشهر ثلاثين يوماً لكل شهر؟", a: "لا، الأشهر تتفاوت بين 28 و31 يوماً. الحاسبة تحسب الأشهر الكاملة بالتقويم لا بقسمة الأيام على 30." },
      { q: "لماذا يختلف عمري بالسنوات عن الفرق بين السنتين؟", a: "لأن العمر لا يزيد إلا في يوم الميلاد. قبله يكون الفرق بين السنتين أكبر من عمرك الفعلي بسنة." },
    ]} />
  </Fragment>
</CalcLayout>

<script>
  import { mountCalculator } from '../scripts/runtime';
  import { calcAge } from '../lib/calc/age';
  import { ageView } from '../lib/views';
  import { localTodayISO } from '../lib/calc/core';
  const root = document.querySelector<HTMLElement>('[data-calc="age"]')!;
  const x = (k: string) => root.querySelector<HTMLElement>(`[data-x="${k}"]`)!;
  const birth = root.querySelector<HTMLInputElement>('#f-birthDate')!;
  birth.max = localTodayISO();
  const calc = mountCalculator(root, {
    compute: (f) => {
      const onDate = localTodayISO();
      const result = calcAge({ birthDate: f.birthDate, onDate });
      return { result, view: result.ok ? ageView(result.value, onDate) : null };
    },
    extras: (a) => {
      x('y').textContent = String(a.years);
      x('m').textContent = String(a.months);
      x('d').textContent = String(a.days);
    },
  });
  // Refresh once when the local date changes, without polling.
  const now = new Date();
  const msToMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1).getTime() - now.getTime() + 1000;
  setTimeout(() => calc.update(), msToMidnight);
</script>
