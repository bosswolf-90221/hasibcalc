---
import Faq from '../components/Faq.astro';
import CalcLayout from '../layouts/CalcLayout.astro';
import SalaryDayCalc from '../components/SalaryDayCalc.astro';
---
<CalcLayout slug="salary-saudi" lede="رواتب القطاع الحكومي في السعودية تُصرف يوم 27 من كل شهر ميلادي. وبحسب وزارة المالية، إذا وافق الجمعة فالصرف الخميس قبله، وإذا وافق السبت فالصرف الأحد بعده. العدّاد أدناه مضبوط على هذه القاعدة، ويمكنك تغيير اليوم إذا كان راتبك في موعد آخر.">
  <SalaryDayCalc example={false} payDay={27} weekend="fri-sat" rule="nearest" hint="القطاع الخاص يصرف بحسب عقد العمل؛ اكتب يوم راتبك إذا كان غير 27." />

  <Fragment slot="article">
    <h2>متى ينزل الراتب في السعودية؟</h2>
    <ul>
      <li><strong>القطاع الحكومي:</strong> يوم 27 من كل شهر ميلادي.</li>
      <li><strong>إذا وافق 27 الجمعة:</strong> يكون الصرف يوم الخميس الذي قبله.</li>
      <li><strong>إذا وافق 27 السبت:</strong> يكون الصرف يوم الأحد الذي بعده.</li>
      <li><strong>قبل الأعياد:</strong> قد يُعلن تقديم الرواتب بقرار خاص، فتابع الإعلان الرسمي.</li>
      <li><strong>القطاع الخاص:</strong> بحسب عقد العمل وسياسة الشركة.</li>
    </ul>
    <div class="example">
      <p>في نوفمبر 2026 يوافق يوم 27 الجمعة، فيُقدَّم الراتب إلى <strong>الخميس 26 نوفمبر</strong>. أما 27 ديسمبر 2026 فيوافق الأحد، فينزل في موعده. و27 فبراير 2027 يوافق السبت، فتعطي القاعدة <strong>الأحد 28 فبراير</strong>. لم نجد تقويم 2027 الرسمي وقت المراجعة، فتأكد من إعلان الوزارة.</p>
    </div>
    <h2>كم يخصم من راتبي للتأمينات؟</h2>
    <p>لمعرفة راتبك الصافي بعد خصم التأمينات الاجتماعية، استخدم <a href="/gosi/">حاسبة الراتب الصافي بعد خصم GOSI</a>.</p>
    <Faq title="أسئلة شائعة" items={[
      { q: "هل رواتب الحكومة السعودية بالتاريخ الهجري أم الميلادي؟", a: "بالميلادي: يوم 27 من كل شهر ميلادي." },
      { q: "ماذا لو وافق يوم 27 الجمعة؟", a: "يكون الصرف يوم الخميس 26. وإذا وافق السبت فيكون يوم الأحد 28، بحسب وزارة المالية." },
      { q: "متى ينزل راتب القطاع الخاص؟", a: "في الموعد المكتوب في عقد العمل. اكتب يوم راتبك في الحاسبة لتعرف الأيام الباقية عليه." },
    ]} />
    <h2>المصادر</h2>
    <ul class="sources">
      <li><a href="https://web.archive.org/web/20261013233930/https://www.mof.gov.sa/mediacenter/Payroll/Pages/2026.aspx" rel="noopener" target="_blank">وزارة المالية السعودية: مواعيد صرف الرواتب 2026 (نسخة مؤرشفة، لأن الصفحة الأصلية لم تفتح وقت المراجعة)</a></li>
    </ul>
  </Fragment>
</CalcLayout>
