---
import Faq from '../components/Faq.astro';
import CalcLayout from '../layouts/CalcLayout.astro';
import SalaryDayCalc from '../components/SalaryDayCalc.astro';
---
<CalcLayout slug="salary-saudi" lede="رواتب القطاع الحكومي في السعودية تُصرف يوم 27 من كل شهر ميلادي، وتُقدَّم إلى الخميس إذا وافق الجمعة أو السبت. العدّاد أدناه مضبوط على هذه القاعدة، ويمكنك تغيير اليوم إذا كان راتبك في موعد آخر.">
  <SalaryDayCalc payDay={27} weekend="fri-sat" rule="before" hint="القطاع الخاص يصرف بحسب عقد العمل؛ اكتب يوم راتبك إذا كان غير 27." />

  <Fragment slot="article">
    <h2>متى ينزل الراتب في السعودية؟</h2>
    <ul>
      <li><strong>القطاع الحكومي:</strong> يوم 27 من كل شهر ميلادي.</li>
      <li><strong>إذا وافق 27 الجمعة أو السبت:</strong> يُقدَّم الإيداع عادة إلى الخميس الذي قبله، ولا يُؤخَّر.</li>
      <li><strong>قبل الأعياد:</strong> قد يُعلن تقديم الرواتب بقرار خاص، فتابع الإعلان الرسمي.</li>
      <li><strong>القطاع الخاص:</strong> بحسب عقد العمل وسياسة الشركة.</li>
    </ul>
    <div class="example">
      <p>في نوفمبر 2026 يوافق يوم 27 الجمعة، فيُقدَّم الراتب إلى <strong>الخميس 26 نوفمبر</strong>. أما 27 ديسمبر 2026 فيوافق الأحد، فينزل في موعده.</p>
    </div>
    <h2>كم يخصم من راتبي للتأمينات؟</h2>
    <p>لمعرفة راتبك الصافي بعد خصم التأمينات الاجتماعية، استخدم <a href="/gosi/">حاسبة الراتب الصافي بعد خصم GOSI</a>.</p>
    <Faq title="أسئلة شائعة" items={[
      { q: "هل رواتب الحكومة السعودية بالتاريخ الهجري أم الميلادي؟", a: "بالميلادي: يوم 27 من كل شهر ميلادي." },
      { q: "ماذا لو وافق يوم 27 الجمعة؟", a: "يُقدَّم الصرف عادة إلى الخميس 26. وإذا وافق السبت يُقدَّم إلى الخميس 25." },
      { q: "متى ينزل راتب القطاع الخاص؟", a: "في الموعد المكتوب في عقد العمل. اكتب يوم راتبك في الحاسبة لتعرف الأيام الباقية عليه." },
    ]} />
    <h2>المصادر</h2>
    <ul class="sources">
      <li><a href="https://sabq.org/article/93kBuYv" rel="noopener" target="_blank">صحيفة سبق: تقديم صرف رواتب موظفي الدولة إلى الخميس بدلاً من الجمعة 27</a></li>
    </ul>
  </Fragment>
</CalcLayout>
