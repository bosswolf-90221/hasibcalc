---
import Faq from '../components/Faq.astro';
import CalcLayout from '../layouts/CalcLayout.astro';
import SalaryDayCalc from '../components/SalaryDayCalc.astro';
---
<CalcLayout slug="salary-day" lede="اكتب يوم نزول راتبك في الشهر، ونحسب كم يوماً باقي عليه من تاريخ اليوم في جهازك. وإذا وافق يوم الراتب عطلة نهاية الأسبوع، ننقله إلى يوم العمل الذي تختاره.">
  <SalaryDayCalc payDay={27} weekend="fri-sat" rule="before" />

  <Fragment slot="article">
    <p class="hint">صفحات مخصّصة: <a href="/salary-saudi/">كم باقي على الراتب في السعودية</a> · <a href="/salary-uae/">كم باقي على الراتب في الإمارات</a></p>
    <h2>متى ينزل الراتب؟</h2>
    <p>موعد الراتب يختلف من جهة إلى أخرى، لذلك تكتب أنت يوم راتبك. ومن أشهر المواعيد في الخليج:</p>
    <ul>
      <li><strong>القطاع الحكومي في السعودية:</strong> يوم 27 من كل شهر ميلادي. وإذا وافق الجمعة أو السبت يُقدَّم عادة إلى الخميس الذي قبله.</li>
      <li><strong>القطاع الخاص:</strong> يحدده عقد العمل، وغالباً في آخر الشهر أو في أيامه الأولى.</li>
      <li><strong>القطاع الخاص في الإمارات:</strong> منذ 1 يونيو 2026 يجب أن يُصرف أجر الشهر عبر نظام حماية الأجور في موعد أقصاه اليوم الأول من الشهر التالي، بحسب القرار الوزاري رقم 340 لسنة 2026.</li>
    </ul>
    <div class="example">
      <p>راتب يوم 27، والعطلة الجمعة والسبت: يوم 27 نوفمبر 2026 يوافق الجمعة، فيُقدَّم الراتب إلى <strong>الخميس 26 نوفمبر</strong>. أما 27 ديسمبر 2026 فيوافق الأحد، فينزل في موعده.</p>
    </div>
    <Faq title="أسئلة شائعة" items={[
      { q: "كم باقي على الراتب الحكومي في السعودية؟", a: "اترك يوم الراتب 27 والعطلة الجمعة والسبت مع خيار «يُقدَّم»، وستظهر عدد الأيام الباقية وتاريخ الراتب القادم واسم اليوم." },
      { q: "ماذا يحدث إذا وافق يوم الراتب الجمعة؟", a: "في القطاع الحكومي السعودي يُقدَّم الصرف عادة إلى الخميس الذي قبله. وفي القطاع الخاص يعتمد ذلك على سياسة صاحب العمل والبنك." },
      { q: "هل تحسب الحاسبة إجازات الأعياد؟", a: "لا. مواعيد العطل الرسمية وتقديم الرواتب قبل الأعياد تُعلن كل سنة، فلا نفترضها مسبقاً." },
      { q: "راتبي في آخر الشهر، ماذا أكتب؟", a: "اكتب 31. في الأشهر التي فيها 30 يوماً أو في فبراير نحسبه في آخر يوم من الشهر." },
    ]} />
    <h2>المصادر</h2>
    <ul class="sources">
      <li><a href="https://sabq.org/article/93kBuYv" rel="noopener" target="_blank">صحيفة سبق: تقديم صرف رواتب موظفي الدولة إلى الخميس بدلاً من الجمعة 27</a></li>
      <li><a href="https://www.mohre.gov.ae/" rel="noopener" target="_blank">وزارة الموارد البشرية والتوطين في الإمارات: نظام حماية الأجور</a></li>
    </ul>
  </Fragment>
</CalcLayout>
