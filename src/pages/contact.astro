---
import Page from '../layouts/Page.astro';
import { SITE } from '../config/site';
const hasForm = Boolean(SITE.contactFormEndpoint);
const hasEmail = Boolean(SITE.contactEmail);
if (!hasForm && !hasEmail) console.warn('[hasib] Contact page: set PUBLIC_CONTACT_FORM_ENDPOINT and/or PUBLIC_CONTACT_EMAIL.');
---
<Page title="اتصل بنا" description="راسل حاسِب لاقتراح حاسبة جديدة أو الإبلاغ عن خطأ في معادلة أو في معلومة منشورة." path="/contact/" crumb="اتصل بنا" heading="اتصل بنا" lede="وجدت خطأ في معادلة؟ تريد حاسبة جديدة؟ اكتب لنا.">
  {hasForm ? (
    <form id="contact" class="cform" action={SITE.contactFormEndpoint} method="POST" novalidate data-endpoint={SITE.contactFormEndpoint}>
      <div class="f"><label for="c-name">اسمك</label><input id="c-name" name="name" required maxlength="80" autocomplete="name" aria-describedby="c-name-err" /><span class="field-error" id="c-name-err" hidden></span></div>
      <div class="f"><label for="c-email">بريدك الإلكتروني</label><input id="c-email" name="email" type="email" required maxlength="120" autocomplete="email" dir="ltr" aria-describedby="c-email-err" /><span class="field-error" id="c-email-err" hidden></span></div>
      <div class="f"><label for="c-topic">الموضوع</label>
        <select id="c-topic" name="topic"><option>اقتراح حاسبة</option><option>خطأ في معادلة</option><option>ملاحظة على التصميم</option><option>أخرى</option></select></div>
      <div class="f"><label for="c-msg">رسالتك</label><textarea id="c-msg" name="message" rows="6" required minlength="10" maxlength="3000" aria-describedby="c-msg-err"></textarea><span class="field-error" id="c-msg-err" hidden></span></div>
      <div class="hp" aria-hidden="true"><label for="c-web">اترك هذا الحقل فارغاً</label><input id="c-web" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
      <button class="btn btn-primary" type="submit">أرسل الرسالة</button>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  ) : null}

  {hasEmail && (
    <div class="mailbox">
      <p>{hasForm ? 'أو راسلنا مباشرة على البريد:' : 'راسلنا على البريد الإلكتروني:'}</p>
      <p><a class="mail" dir="ltr" href={`mailto:${SITE.contactEmail}?subject=${encodeURIComponent('رسالة إلى حاسِب')}`}>{SITE.contactEmail}</a></p>
      <p class="hint">اكتب في رسالتك رابط الصفحة إن كانت ملاحظتك عن حاسبة معيّنة. نقرأ الرسائل ونرد عليها في أقرب وقت.</p>
    </div>
  )}
  <h2>كيف تساعدنا على التصحيح بسرعة؟</h2>
  <p>إذا وجدت خطأ في نتيجة أو معلومة، فاذكر في رسالتك:</p>
  <ul>
    <li>رابط الصفحة، والأرقام التي كتبتها في الحاسبة.</li>
    <li>النتيجة التي ظهرت لك، والنتيجة التي تتوقعها.</li>
    <li>المصدر الذي تعتمد عليه إن وجد، ويفضل أن يكون جهة رسمية.</li>
  </ul>
  <p>نتحقق من الملاحظة، وإن كانت صحيحة نصحّح الصفحة ونحدّث تاريخ التعديل فيها. والطريقة مشروحة في <a href="/about/">من نحن وكيف نحسب</a>.</p>
  <h2>ما لا نستطيع المساعدة فيه</h2>
  <p>لا نقدم استشارة قانونية أو مالية أو طبية أو شرعية، ولا نستطيع مراجعة حالتك الخاصة. لهذه الأسئلة اسأل الجهة المختصة في بلدك.</p>
  <p class="hint">لا نشارك بياناتك مع أحد، ونستخدمها للرد على رسالتك فقط. التفاصيل في <a href="/privacy/">سياسة الخصوصية</a>.</p>
</Page>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact');
  if (form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const setErr = (id: string, msg: string) => {
      const input = form.querySelector<HTMLElement>(`#${id}`)!;
      const err = form.querySelector<HTMLElement>(`#${id}-err`)!;
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      err.textContent = msg;
      err.hidden = !msg;
      return !msg;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const msg = String(fd.get('message') || '').trim();
      const okName = setErr('c-name', name ? '' : 'اكتب اسمك');
      const okEmail = setErr('c-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? '' : 'اكتب بريداً إلكترونياً صحيحاً');
      const okMsg = setErr('c-msg', msg.length >= 10 ? '' : 'الرسالة قصيرة جداً، اكتب 10 أحرف على الأقل');
      if (!(okName && okEmail && okMsg)) return;
      if (fd.get('_gotcha')) return; // bot
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      status.textContent = 'جارٍ الإرسال…';
      try {
        const res = await fetch(form.dataset.endpoint!, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = 'وصلتنا رسالتك، شكراً لك. سنرد على بريدك قريباً.';
      } catch {
        status.textContent = 'لم نتمكن من إرسال الرسالة الآن. رسالتك ما زالت في النموذج، حاول مرة أخرى بعد قليل.';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
