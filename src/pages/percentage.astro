---
import CalcLayout from '../layouts/CalcLayout.astro';
import NumIn from '../components/NumIn.astro';
import FieldErrors from '../components/FieldErrors.astro';
import ResultCard from '../components/ResultCard.astro';
import { percentOf, whatPercent, percentChange } from '../lib/calc/percentage';
import { pctOfView, whatPctView, changeView } from '../lib/views-percentage';

const a = percentOf(40, 250);
const b = whatPercent(40, 250);
const c = percentChange(250, 300);
---
<CalcLayout slug="percentage" lede="ثلاثة أسئلة مختلفة تُخلط كثيراً. لكل سؤال جملته ونتيجته، فاختر السؤال الذي يطابق حالتك.">
  <section class="pq card calc-card" data-calc="pct-of" aria-labelledby="q1">
    <h2 id="q1" class="q">نسبة من رقم</h2>
    <form class="sentence" onsubmit="return false">كم يساوي <NumIn name="p1_percent" label="النسبة المئوية" value={40} width={3} />% من <NumIn name="p1_base" label="الرقم" value={250} width={6} />؟</form>
    <FieldErrors names={['p1_percent', 'p1_base']} />
    <ResultCard uid="r1" view={pctOfView(a, '40', '250')}>
      <p class="formula" slot="formula"><code>النتيجة = الرقم × النسبة ÷ 100</code></p>
    </ResultCard>
  </section>

  <section class="pq card calc-card" data-calc="what-pct" aria-labelledby="q2">
    <h2 id="q2" class="q">كم يمثل رقم من آخر</h2>
    <form class="sentence" onsubmit="return false">كم يمثل <NumIn name="p2_part" label="الجزء" value={40} width={5} /> من <NumIn name="p2_whole" label="الكل" value={250} width={6} />؟</form>
    <FieldErrors names={['p2_part', 'p2_whole']} />
    <ResultCard uid="r2" view={whatPctView(b, '40', '250')}>
      <p class="formula" slot="formula"><code>النسبة = الجزء ÷ الكل × 100</code></p>
    </ResultCard>
  </section>

  <section class="pq card calc-card" data-calc="change" aria-labelledby="q3">
    <h2 id="q3" class="q">نسبة الزيادة أو النقص</h2>
    <form class="sentence" onsubmit="return false">تغيّرت القيمة من <NumIn name="p3_from" label="القيمة الأصلية" value={250} width={6} /> إلى <NumIn name="p3_to" label="القيمة الجديدة" value={300} width={6} /></form>
    <FieldErrors names={['p3_from', 'p3_to']} />
    <ResultCard uid="r3" view={changeView(c, '250', '300')}>
      <p class="formula" slot="formula"><code>التغير = (الجديدة − الأصلية) ÷ |الأصلية| × 100</code></p>
    </ResultCard>
  </section>

  <Fragment slot="article">
    <h2>لماذا ثلاثة أسئلة وليس سؤالاً واحداً؟</h2>
    <p>«كم يساوي 40% من 250؟» جوابه 100. أما «كم تمثل 40 من 250؟» فجوابه 16%. الرقمان نفسهما، والسؤالان مختلفان تماماً. ونسبة التغير سؤال ثالث تكون فيه القيمة الأصلية هي الأساس دائماً.</p>
    <div class="example">
      <p>راتب ارتفع من 8,000 إلى 9,000: الزيادة = (9,000 − 8,000) ÷ 8,000 × 100 = 12.5%. ولو رجع من 9,000 إلى 8,000 فالنقص 11.1%، وليس 12.5%، لأن الأساس تغيّر.</p>
    </div>
    <h2>أخطاء شائعة</h2>
    <ul>
      <li>القسمة على القيمة الجديدة بدلاً من الأصلية عند حساب التغير.</li>
      <li>جمع نسب متتالية: زيادة 10% ثم 10% تساوي 21% وليس 20%.</li>
      <li>الخلط بين «نقطة مئوية» و«نسبة مئوية»: انتقال الفائدة من 4% إلى 5% زيادة نقطة واحدة، لكنه زيادة 25% في قيمة الفائدة نفسها.</li>
    </ul>
    <h2>متى لا تنطبق؟</h2>
    <p>لا يمكن حساب نسبة من كلٍّ يساوي صفراً، ولا تغيّر من قيمة أصلية تساوي صفراً. الحاسبة تخبرك بذلك بدلاً من عرض رقم لا معنى له.</p>
  </Fragment>
</CalcLayout>

<style>
  .pq + .pq { margin-top: 20px; }
  .q { font-size: .95rem; font-weight: 600; color: var(--accent); margin-bottom: 0; }
  .pq :global(.result) { margin-top: 18px; padding-block: 20px 14px; box-shadow: none; }
  .pq :global(.r-value) { font-size: clamp(2.2rem, 8vw, 3.2rem); }
</style>

<script>
  import { mountCalculator, num } from '../scripts/runtime';
  import { percentOf, whatPercent, percentChange } from '../lib/calc/percentage';
  import { pctOfView, whatPctView, changeView } from '../lib/views-percentage';
  const q = (s: string) => document.querySelector<HTMLElement>(`[data-calc="${s}"]`)!;
  mountCalculator(q('pct-of'), { compute: (f) => { const r = percentOf(num(f.p1_percent), num(f.p1_base)); return { result: r, view: pctOfView(r, f.p1_percent, f.p1_base) }; } });
  mountCalculator(q('what-pct'), { compute: (f) => { const r = whatPercent(num(f.p2_part), num(f.p2_whole)); return { result: r, view: whatPctView(r, f.p2_part, f.p2_whole) }; } });
  mountCalculator(q('change'), { compute: (f) => { const r = percentChange(num(f.p3_from), num(f.p3_to)); return { result: r, view: changeView(r, f.p3_from, f.p3_to) }; } });
</script>
