---
import Base from '../layouts/Base.astro';
import { CALCULATORS, CATEGORIES, inCategory, bySlug } from '../data/calculators';
import { SITE } from '../config/site';

const suggestions = ['نهاية الخدمة', 'ضريبة 5%', 'قسط سيارة', 'زكاة', 'خصم', 'وزني', 'عمري'];
const pairs: [string, string, string][] = [
  ['end-of-service', 'zakat', 'استلمت مكافأتك؟ قد تبلغ مدخراتك النصاب'],
  ['discount', 'vat', 'بعد الخصم، أضف الضريبة لتعرف ما ستدفعه'],
  ['loan', 'percentage', 'قارن عرضين بنسبة التغير بين قسطيهما'],
];
---
<Base title={`${SITE.name}: ماذا تريد أن تحسب اليوم؟ حاسبات عربية مجانية`} description="حاسبات عربية مجانية وواضحة: مكافأة نهاية الخدمة في الإمارات، القسط الشهري، ضريبة القيمة المضافة، الزكاة، الخصم، النسبة المئوية، العمر ومؤشر كتلة الجسم." path="/" wide current="home">
  <section class="intro">
    <p class="eyebrow">{SITE.tagline}</p>
    <h1>ماذا تريد أن تحسب اليوم؟</h1>
    <p class="lede">اختر سؤالك، واكتب أرقامك في جملة واحدة، والإجابة تظهر فوراً مع طريقة حسابها.</p>

    <div class="search" role="search">
      <label for="q" class="sr-only">ابحث عن حاسبة</label>
      <input id="q" type="search" placeholder="ابحث: نهاية الخدمة، ضريبة، قسط…" autocomplete="off" aria-controls="search-results" />
      <div class="sugg" aria-label="اقتراحات">
        {suggestions.map((s) => <button type="button" class="chip" data-s={s}>{s}</button>)}
      </div>
      <ul id="search-results" class="qs" hidden aria-live="polite"></ul>
      <p class="empty" hidden>لا توجد حاسبة بهذا الاسم بعد. جرّب كلمة أخرى، أو <a href="/contact/">اقترح حاسبة</a>.</p>
    </div>
  </section>

  <section class="cats" aria-label="الحاسبات حسب الموضوع" id="all">
    {CATEGORIES.map((cat) => (
      <div class="cat">
        <h2><a href={`/category/${cat.key}/`}>{cat.name}</a></h2>
        <p class="cat-intro">{cat.intro}</p>
        <ul class="qs">
          {inCategory(cat.key).map((c) => (
            <li><a href={`/${c.slug}/`}><span>{c.question}<span class="meta">{c.short}</span></span><span class="ar" aria-hidden="true">←</span></a></li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="pairs" aria-labelledby="pairs-title">
    <h2 id="pairs-title">أسئلة تأتي معاً</h2>
    <ul>
      {pairs.map(([a, b, why]) => (
        <li>
          <p>{why}</p>
          <a href={`/${a}/`}>{bySlug(a).question}</a>
          <span aria-hidden="true">ثم</span>
          <a href={`/${b}/`}>{bySlug(b).question}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="method" aria-labelledby="method-title">
    <h2 id="method-title">كيف نحسب؟</h2>
    <div class="method-grid">
      <p><strong>معادلات ثابتة، لا تخمين.</strong> كل نتيجة تأتي من معادلة معروضة في صفحتها تحت «كيف حسبناها؟»، وتتحقق منها اختبارات آلية.</p>
      <p><strong>مصادر رسمية.</strong> القوانين والنسب مأخوذة من جهات حكومية ومراجع معتمدة، مذكورة في نهاية كل صفحة مع تاريخ آخر مراجعة.</p>
      <p><strong>أرقامك تبقى عندك.</strong> الحساب يتم داخل متصفحك، ولا نرسل ما تكتبه إلى أي خادم.</p>
    </div>
    <p><a href="/about/">اقرأ المنهجية وحدود الدقة ←</a></p>
  </section>
</Base>

<style>
  .intro { max-width: var(--read); }
  .intro h1 { font-weight: 300; font-size: var(--step-4); margin-bottom: 10px; }
  .search { margin-top: 26px; }
  .search input {
    width: 100%; font: inherit; font-size: 1.15rem; color: var(--ink); background: var(--surface);
    border: 1px solid var(--line); border-radius: 14px; padding: 14px 18px; min-height: 54px;
  }
  .search input:focus { outline: none; border-color: var(--accent); }
  .sugg { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .chip { font: inherit; font-size: .88rem; color: var(--soft); background: transparent; border: 1px solid var(--line); border-radius: 99px; padding: 6px 14px; min-height: 38px; cursor: pointer; }
  .chip:hover { color: var(--accent); border-color: var(--accent); }
  #search-results { margin-top: 10px; }
  .empty { color: var(--soft); margin-top: 14px; }

  .cats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--line); }
  .cat h2 { font-size: var(--step-0); font-weight: 500; margin: 0; }
  .cat h2 a { text-decoration: none; }
  .cat-intro { color: var(--soft); font-size: var(--step--1); margin: 4px 0 6px; min-height: 3.4em; }
  .cat .qs a { font-size: 1.12rem; }

  .pairs { margin-top: 64px; }
  .pairs h2, .method h2 { font-size: var(--step--1); font-weight: 400; color: var(--soft); }
  .pairs ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .pairs li { background: var(--surface); border-radius: var(--radius); padding: 18px 20px; display: flex; flex-direction: column; gap: 4px; }
  .pairs li p { color: var(--soft); font-size: var(--step--1); margin: 0 0 6px; }
  .pairs li a { color: var(--accent); text-decoration: none; font-weight: 400; }
  .pairs li a:hover { text-decoration: underline; }
  .pairs li span { color: var(--soft); font-size: .8rem; }

  .method { margin-top: 64px; max-width: var(--read); }
  .method-grid { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }
  .method strong { font-weight: 500; }
  .method a { color: var(--accent); text-decoration: none; }

  @media (max-width: 860px) {
    .cats { grid-template-columns: 1fr; gap: 28px; margin-top: 48px; }
    .cat-intro { min-height: 0; }
    .pairs ul { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { CALCULATORS } from '../data/calculators';
  const norm = (s: string) =>
    s.toLowerCase()
      .replace(/[ً-ْـ]/g, '')
      .replace(/[أإآ]/g, 'ا')
      .replace(/ى/g, 'ي')
      .replace(/ة/g, 'ه')
      .replace(/ؤ/g, 'و')
      .replace(/ئ/g, 'ي')
      .replace(/[٠-٩]/g, (d) => String('٠١٢٣٤٥٦٧٨٩'.indexOf(d)))
      .replace(/^ال/, '')
      .trim();
  const items = CALCULATORS.map((c) => ({ c, hay: norm([c.question, c.short, ...c.terms].join(' ')) }));
  const input = document.querySelector<HTMLInputElement>('#q')!;
  const list = document.querySelector<HTMLUListElement>('#search-results')!;
  const empty = document.querySelector<HTMLElement>('.empty')!;

  function run() {
    const q = norm(input.value);
    if (!q) { list.hidden = true; empty.hidden = true; return; }
    const words = q.split(/\s+/).map((w) => w.replace(/^ال/, '')).filter(Boolean);
    const hits = items.filter((it) => words.every((w) => it.hay.includes(w)));
    list.replaceChildren(
      ...hits.map(({ c }) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/${c.slug}/`;
        const t = document.createElement('span');
        t.textContent = c.question;
        const ar = document.createElement('span');
        ar.className = 'ar';
        ar.setAttribute('aria-hidden', 'true');
        ar.textContent = '←';
        a.append(t, ar);
        li.append(a);
        return li;
      }),
    );
    list.hidden = hits.length === 0;
    empty.hidden = hits.length !== 0;
  }
  input.addEventListener('input', run);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const first = list.querySelector('a');
      if (first) location.href = first.getAttribute('href')!;
    }
  });
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) =>
    b.addEventListener('click', () => { input.value = b.dataset.s!; run(); input.focus(); }),
  );
</script>
