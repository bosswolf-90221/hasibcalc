---
import Faq from '../components/Faq.astro';
import CalcLayout from '../layouts/CalcLayout.astro';
import SalaryDayCalc from '../components/SalaryDayCalc.astro';
---
<CalcLayout slug="salary-uae" lede="منذ 1 يونيو 2026 يجب أن يُصرف أجر القطاع الخاص في الإمارات في موعد أقصاه اليوم الأول من الشهر التالي. العدّاد مضبوط على هذا الموعد، ويمكنك كتابة يوم راتبك إذا كانت شركتك تصرفه قبله.">
  <SalaryDayCalc payDay={1} weekend="sat-sun" rule="none" hint="كثير من الشركات تصرف قبل الموعد الأقصى، مثلاً يوم 25 أو آخر الشهر؛ اكتب يوم راتبك أنت." />

  <Fragment slot="article">
    <h2>متى ينزل الراتب في الإمارات؟</h2>
    <p>في <strong>القطاع الخاص</strong> يُصرف الأجر عبر نظام حماية الأجور. وبحسب <strong>القرار الوزاري رقم 340 لسنة 2026</strong> الصادر عن وزارة الموارد البشرية والتوطين، والمعمول به منذ 1 يونيو 2026، يجب أن يُصرف أجر كل شهر ميلادي في موعد أقصاه <strong>اليوم الأول من الشهر التالي</strong>.</p>
    <ul>
      <li>يُعد صاحب العمل ملتزماً إذا صرف 85% على الأقل من إجمالي الأجور المستحقة في الموعد.</li>
      <li>بعد الموعد تبدأ إجراءات متدرجة على المنشأة المتأخرة، من التنبيه إلى إيقاف تصاريح العمل الجديدة ثم المخالفات.</li>
      <li>يمكن للشركة أن تصرف قبل الموعد الأقصى، فإن كان راتبك يوم 25 مثلاً فاكتبه في الحاسبة.</li>
    </ul>
    <div class="example">
      <p>أجر شهر نوفمبر 2026 يجب أن يُصرف في موعد أقصاه <strong>الثلاثاء 1 ديسمبر 2026</strong>.</p>
    </div>
    <h2>مكافأة نهاية الخدمة</h2>
    <p>لحساب مكافأة نهاية الخدمة في القطاع الخاص وفق المادة 51، استخدم <a href="/end-of-service/">حاسبة نهاية الخدمة</a>.</p>
    <Faq title="أسئلة شائعة" items={[
      { q: "ما آخر موعد لصرف الراتب في الإمارات؟", a: "في القطاع الخاص، اليوم الأول من الشهر الميلادي التالي، بحسب القرار الوزاري رقم 340 لسنة 2026 المعمول به منذ 1 يونيو 2026." },
      { q: "هل ما زالت مهلة الـ15 يوماً موجودة؟", a: "القرار الجديد حلّ محل القرار رقم 598 لسنة 2022، ويحسب التأخير من اليوم التالي للموعد الأقصى. راجع وزارة الموارد البشرية والتوطين لأي حالة خاصة." },
      { q: "هل القاعدة تشمل موظفي الحكومة؟", a: "القرار يخص القطاع الخاص المسجل لدى وزارة الموارد البشرية والتوطين. الجهات الحكومية لها مواعيدها الخاصة." },
    ]} />
    <h2>المصادر</h2>
    <ul class="sources">
      <li><a href="https://www.ey.com/en_gl/technical/tax-alerts/uae-introduces-enhanced-wage-protection-system-effective-1-june-2026" rel="noopener" target="_blank">EY: نظام حماية الأجور المعزز في الإمارات (القرار الوزاري 340 لسنة 2026)</a></li>
      <li><a href="https://www.mohre.gov.ae/" rel="noopener" target="_blank">وزارة الموارد البشرية والتوطين</a></li>
    </ul>
  </Fragment>
</CalcLayout>
