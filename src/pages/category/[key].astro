---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CalcCard from '../../components/CalcCard.astro';
import { CATEGORIES, inCategory, CALCULATORS } from '../../data/calculators';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { key: c.key } }));
}
const cat = CATEGORIES.find((c) => c.key === Astro.params.key)!;
const items = inCategory(cat.key);
const outside = CALCULATORS.filter((c) => !c.categories.includes(cat.key)).slice(0, 3);
---
<Base title={`حاسبات ${cat.name}`} description={cat.description} path={`/category/${cat.key}/`} bare>
  <section class="band">
    <div class="container band-inner">
      <nav class="crumbs" aria-label="مسار التنقل"><ol><li><a href="/">الرئيسية</a></li><li aria-current="page">{cat.name}</li></ol></nav>
      <div class="titlerow">
        <span class="tile big-tile" data-cat={cat.key}><Icon name={cat.key} size={28} /></span>
        <div><h1>{cat.name}</h1><p class="lede" style="margin:4px 0 0">{cat.intro}</p></div>
      </div>
    </div>
  </section>
  <div class="container" style="padding-top:28px">
    <div class="grid-cards">{items.map((c) => <CalcCard c={c} />)}</div>
    <h2 style="margin-top:48px">من تصنيفات أخرى</h2>
    <div class="grid-cards">{outside.map((c) => <CalcCard c={c} />)}</div>
  </div>
</Base>
