---
import Base from '../../layouts/Base.astro';
import CalcIndex from '../../components/CalcIndex.astro';
import { CATEGORIES, inCategory, CALCULATORS } from '../../data/calculators';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { key: c.key } }));
}
const cat = CATEGORIES.find((c) => c.key === Astro.params.key)!;
const items = inCategory(cat.key);
const outside = CALCULATORS.filter((c) => !c.categories.includes(cat.key));
---
<Base title={`حاسبات ${cat.name}`} description={cat.description} path={`/category/${cat.key}/`} bare>
  <div class="container">
    <header class="calc-head">
      <div class="meta">
        <span class="big nums">{String(items.length).padStart(2, '0')}<small> حاسبات</small></span>
        <span>تصنيف</span>
      </div>
      <div class="title">
        <nav class="crumbs" aria-label="مسار التنقل"><ol><li><a href="/">الرئيسية</a></li><li aria-current="page">{cat.name}</li></ol></nav>
        <h1>{cat.name}</h1>
        <p class="lede">{cat.intro}</p>
      </div>
    </header>
    <div class="calc-body">
      <aside class="side">
        <p class="side-label">تصنيفات أخرى</p>
        <ul class="side-toc">{CATEGORIES.filter((c) => c.key !== cat.key).map((c) => <li><a href={`/category/${c.key}/`}>{c.name}</a></li>)}</ul>
      </aside>
      <div class="main">
        <CalcIndex items={items} />
        <section class="related">
          <div class="related-head"><h2>من تصنيفات أخرى</h2><a href="/#index">كل الحاسبات</a></div>
          <CalcIndex items={outside} compact />
        </section>
      </div>
    </div>
  </div>
</Base>
