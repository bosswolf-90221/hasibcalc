---
import '../../styles/calc.css';
import Site from '../../layouts/Site.astro';
import Faq from '../../components/Faq.astro';
import { CATEGORIES, inCategory } from '../../data/calculators';
import { GUIDES } from '../../data/guides';
import { MOMENTS } from '../../data/moments';
import { plural } from '../../lib/format';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { key: c.key } }));
}
const cat = CATEGORIES.find((c) => c.key === Astro.params.key)!;
const items = inCategory(cat.key);
const slugs = new Set(items.map((c) => c.slug));
const guides = GUIDES.filter((g) => slugs.has(g.calc));
const tint = (slug: string) => MOMENTS.find((m) => m.calcs.includes(slug))!.tint;
---
<Site title={cat.seoTitle} description={cat.description} path={`/category/${cat.key}/`}>
  <div class="wrap calc-page">
    <nav class="crumbs" aria-label="مسار التنقل"><ol><li><a href="/">الرئيسية</a></li><li><a href="/calculators/">كل الحاسبات</a></li><li aria-current="page">{cat.name}</li></ol></nav>
    <header class="page-head">
      <p class="guide-meta">{plural(items.length, { one: 'حاسبة واحدة', two: 'حاسبتان', few: 'حاسبات', many: 'حاسبة' })}</p>
      <h1 class="t-h1">{cat.name}</h1>
      <p class="t-lead">{cat.intro}</p>
    </header>
    <section aria-labelledby="w-h">
      <h2 id="w-h" class="t-h2 sec-title">أي حاسبة تجيب عن سؤالك؟</h2>
      <ul class="guide-cards">
        {items.map((c) => <li style={`--tint: var(--moment-${tint(c.slug)})`}><a href={`/${c.slug}/`}><b>{c.question}</b><span>{c.description}</span></a></li>)}
      </ul>
    </section>
    <div class="article cat-body">
      {guides.length > 0 && <>
        <h2>أدلة في هذا التصنيف</h2>
        <ul class="linklist cat-guides">
          {guides.map((g) => <li><a href={`/guides/${g.slug}/`}><b>{g.title}</b><span>{g.description}</span></a></li>)}
        </ul>
      </>}
      <Faq items={cat.faq} />
    </div>
    <nav class="cat-others" aria-labelledby="o-h">
      <h2 id="o-h">تصنيفات أخرى</h2>
      <ul>
        {CATEGORIES.filter((c) => c.key !== cat.key).map((c) => <li><a class="btn" href={`/category/${c.key}/`}>{c.name}</a></li>)}
        <li><a class="btn" href="/calculators/">كل الحاسبات</a></li>
      </ul>
    </nav>
  </div>
</Site>
