---
import '../../styles/calc.css';
import Site from '../../layouts/Site.astro';
import { MOMENTS } from '../../data/moments';
import { GUIDES } from '../../data/guides';
import { plural } from '../../lib/format';
const momentOf = (slug: string, calc: string) => MOMENTS.find((m) => m.guides.includes(slug)) ?? MOMENTS.find((m) => m.calcs.includes(calc))!;
---
<Site title="أدلة حاسِب: شرح مبسط للحسابات اليومية" description="أدلة عربية مبسطة: مكافأة نهاية الخدمة، الفائدة الثابتة والمتناقصة، ضريبة القيمة المضافة في الخليج، الزكاة، مواعيد رمضان، وأسابيع الحمل." path="/guides/" bare>
  <div class="wrap calc-page">
    <nav class="crumbs" aria-label="مسار التنقل"><ol><li><a href="/">الرئيسية</a></li><li aria-current="page">أدلة</li></ol></nav>
    <header class="page-head">
      <p class="guide-meta">{plural(GUIDES.length, { one: 'دليل واحد', two: 'دليلان', few: 'أدلة', many: 'دليلاً' })}</p>
      <h1 class="t-h1">أدلة تشرح الرقم قبل أن تحسبه</h1>
      <p class="t-lead">كل دليل يجيب عن سؤال واحد بأمثلة محسوبة، ويوصلك إلى الحاسبة المناسبة.</p>
    </header>
    <ul class="guide-cards">
      {GUIDES.map((g) => { const m = momentOf(g.slug, g.calc); return <li style={`--tint: var(--moment-${m.tint})`}><a href={`/guides/${g.slug}/`}><small>{g.kicker} · {g.minutes} دقائق</small><b>{g.title}</b><span>{g.description}</span></a></li>; })}
    </ul>
    <section class="article guides-how" aria-labelledby="how-h">
      <h2 id="how-h">كيف نكتب أدلتنا؟</h2>
      <p>كل دليل يبدأ بالجواب أو بالخلاصة في أعلى الصفحة، ثم يشرح المعادلة بخطوات، ثم يحل مثالاً بأرقام تحققنا منها بتشغيل الحساب. وحيث توجد قاعدة قانونية أو مالية أو صحية نضع في آخر الدليل رابط الجهة الرسمية التي أخذناها منها، مثل البوابة الرسمية لحكومة الإمارات أو الهيئة الاتحادية للضرائب.</p>
      <h2>من أين أبدأ؟</h2>
      <ul>
        <li>إذا كان سؤالك عن العمل والمال فابدأ بدليل مكافأة نهاية الخدمة أو دليل الزكاة أو دليل الفائدة الثابتة والمتناقصة.</li>
        <li>إذا كان سؤالك عن التسوق والنسب فابدأ بدليل النسبة المئوية أو دليل ضريبة القيمة المضافة أو دليل الجمعة البيضاء.</li>
        <li>إذا كان سؤالك عن المواعيد فابدأ بدليل رمضان 1448 أو دليل رأس السنة 2027 أو دليل اليوم الوطني.</li>
        <li>إذا كان سؤالك عن الصحة والعمر فابدأ بدليل الوزن المثالي بحسب الطول أو دليل أسابيع الحمل أو دليل العمر بالهجري.</li>
      </ul>
      <p>وللحساب مباشرة بأرقامك انتقل إلى <a href="/calculators/">قائمة الحاسبات</a>، وكل حاسبة تحسب في متصفحك دون أن ترسل أرقامك إلى أي خادم. وإن وجدت خطأ في دليل فراسلنا على <a href="/contact/">صفحة التواصل</a>.</p>
    </section>
  </div>
</Site>
