---
import Faq from '../../components/Faq.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';
import Countdown from '../../components/Countdown.astro';
import AddToCalendar from '../../components/AddToCalendar.astro';
const PRICES = [100, 250, 500, 1000, 2000];
const OFFS = [20, 30, 50, 70];
const f = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 2 });
---
<GuideLayout slug="white-friday-2026">
  <Countdown target="2026-11-27" label="باقي على الجمعة البيضاء 2026" today="اليوم الجمعة البيضاء. تسوّق بذكاء" done="انتهت الجمعة البيضاء 2026" note="يوم الجمعة 27 نوفمبر 2026. كثير من المتاجر تبدأ عروضها قبله بأيام وتمدّها بعده." />
  <AddToCalendar title="الجمعة البيضاء 2026" dates={["2026-11-27"]} details="الجمعة 27 نوفمبر 2026. احسب الخصم الحقيقي على hasibcalc.com/discount/" file="white-friday-2026" />

  <h2>الخلاصة</h2>
  <p>الجمعة البيضاء هي اسم «بلاك فرايدي» في متاجر الخليج، وتوافق في 2026 يوم <strong>الجمعة 27 نوفمبر</strong>. قبل أن تشتري، احسب الخصم بنفسك: نسبة الخصم الحقيقية هي <strong>(السعر القديم − السعر الجديد) ÷ السعر القديم</strong>، والخصومات المتتالية لا تُجمع.</p>
  <div class="cta"><p>عندك سعر قبل الخصم وبعده؟</p><a href="/discount/">احسب الخصم الآن ←</a></div>

  <h2>كيف تحسب نسبة الخصم الحقيقية؟</h2>
  <p>اطرح السعر الجديد من القديم، ثم اقسم الفرق على السعر القديم، واضرب في 100.</p>
  <div class="example">
    <p>جهاز كان بـ<strong>2,400</strong> درهم وصار بـ<strong>1,800</strong>: الفرق 600، و600 ÷ 2,400 = 0.25، أي خصم <strong>25%</strong>، لا 33% كما قد يبدو إذا قسمت على السعر الجديد.</p>
  </div>

  <h2>كم يصبح السعر بعد الخصم؟ جدول جاهز</h2>
  <p>السعر بعد الخصم = السعر × (100 − نسبة الخصم) ÷ 100. فبعد خصم 30% تدفع 70% من السعر.</p>
  <div class="scroll-x"><table>
    <thead><tr><th>السعر قبل الخصم</th>{OFFS.map((o) => <th>بعد خصم {o}%</th>)}</tr></thead>
    <tbody>{PRICES.map((p) => <tr><td>{f(p)}</td>{OFFS.map((o) => <td>{f(p * (100 - o) / 100)}</td>)}</tr>)}</tbody>
  </table></div>
  <p>ولأي سعر أو نسبة أخرى، أو لخصمين متتاليين، استخدم <a href="/discount/">حاسبة الخصم</a>.</p>

  <h2>لماذا لا يساوي 30% + 20% خصماً 50%؟</h2>
  <p>لأن الخصم الثاني يُحسب على السعر بعد الخصم الأول، لا على السعر الأصلي.</p>
  <table>
    <thead><tr><th>الخطوة</th><th>الحساب</th><th>السعر</th></tr></thead>
    <tbody>
      <tr><td>السعر الأصلي</td><td>—</td><td>1,000</td></tr>
      <tr><td>خصم 30%</td><td>1,000 × 0.70</td><td>700</td></tr>
      <tr><td>كوبون إضافي 20%</td><td>700 × 0.80</td><td>560</td></tr>
      <tr><td>الخصم الكلي</td><td>(1,000 − 560) ÷ 1,000</td><td>44%</td></tr>
    </tbody>
  </table>
  <p>القاعدة: اضرب «الباقي» من كل خصم، أي 0.70 × 0.80 = 0.56، فتدفع 56% من السعر، والخصم الكلي 44%.</p>

  <h2>«اشترِ 2 واحصل على الثالث مجاناً» كم خصمها؟</h2>
  <p>تدفع ثمن قطعتين وتأخذ ثلاثاً، فالخصم على كل قطعة <strong>33.3%</strong>، لا 50%. وهو خصم مفيد فقط إذا كنت ستستخدم القطع الثلاث فعلاً.</p>

  <h2>علامات الخصم الوهمي</h2>
  <ul>
    <li><strong>سعر «قبل» لم يُبَع به المنتج أصلاً:</strong> بعض المتاجر ترفع السعر قبل الموسم بأسابيع ثم «تخفضه». صوّر صفحة المنتج من الآن، وقارن السعر يوم العرض.</li>
    <li><strong>الخصم على ملحقات لا تحتاجها:</strong> حزمة فيها قطع إضافية ترفع المبلغ النهائي.</li>
    <li><strong>رسوم الشحن والتقسيط:</strong> احسب المبلغ النهائي شاملاً الشحن وأي رسوم تقسيط، لا السعر المعروض فقط.</li>
    <li><strong>سعر الوحدة:</strong> في المواد الاستهلاكية قارن سعر الكيلو أو اللتر أو القطعة، لا سعر العبوة.</li>
    <li><strong>العدّاد التنازلي «باقي ساعة»:</strong> ضغط نفسي يتكرر كل يوم في الموسم. خذ وقتك.</li>
  </ul>

  <h2>هل السعر شامل الضريبة؟</h2>
  <p>في الإمارات تُضاف ضريبة القيمة المضافة 5%، وفي السعودية 15%. الأسعار المعروضة للمستهلك تكون عادة شاملة الضريبة، لكن تأكد في صفحة الدفع. ولمعرفة السعر قبل الضريبة استخدم <a href="/vat/">حاسبة الضريبة</a>.</p>

  <Faq title="أسئلة شائعة" items={[
    { q: "متى الجمعة البيضاء 2026؟", a: "يوم الجمعة 27 نوفمبر 2026، وهو اليوم التالي لعيد الشكر الأمريكي. وتمتد العروض في كثير من المتاجر أسبوعاً أو أكثر حوله." },
    { q: "ما الفرق بين الجمعة البيضاء والبلاك فرايدي؟", a: "هما الموسم نفسه. اسم «الجمعة البيضاء» تستخدمه متاجر عربية كثيرة بدل «الجمعة السوداء»." },
    { q: "كيف أعرف أن الخصم حقيقي؟", a: "قارن السعر بسعره قبل الموسم بأسابيع، واحسب النسبة على السعر القديم الحقيقي، وأضف الشحن والرسوم إلى المبلغ النهائي." },
    { q: "كم السعر بعد خصم 30%؟", a: "اضرب السعر في 0.70. مثلاً 500 بعد خصم 30% تصبح 350، و1,000 تصبح 700." },
    { q: "كم باقي على الجمعة البيضاء؟", a: "العدّاد في أعلى الصفحة يعرض الأيام والساعات الباقية حتى الجمعة 27 نوفمبر 2026 بحسب تاريخ جهازك." },
    { q: "خصم 50% ثم 50% هل يصبح مجاناً؟", a: "لا. يصبح السعر 0.5 × 0.5 = 25% من الأصلي، أي خصم كلي 75%." },
  ]} />

  <h2>المصادر</h2>
  <ul class="sources">
    <li><a href="https://tax.gov.ae/" rel="noopener" target="_blank">الهيئة الاتحادية للضرائب، الإمارات (ضريبة القيمة المضافة 5%)</a></li>
    <li><a href="https://zatca.gov.sa/" rel="noopener" target="_blank">هيئة الزكاة والضريبة والجمارك، السعودية (ضريبة القيمة المضافة 15%)</a></li>
  </ul>
</GuideLayout>
