---
import Faq from '../../components/Faq.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';
import Countdown from '../../components/Countdown.astro';
import AddToCalendar from '../../components/AddToCalendar.astro';
const MONTHS = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
const DAYS = ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
// Per month of 2027: days, first weekday, Monday–Friday count (UAE federal working week, before public holidays).
const months = MONTHS.map((name, i) => {
  const n = new Date(Date.UTC(2027, i + 1, 0)).getUTCDate();
  let work = 0;
  for (let d = 1; d <= n; d++) { const wd = new Date(Date.UTC(2027, i, d)).getUTCDay(); if (wd >= 1 && wd <= 5) work++; }
  return { name, n, first: DAYS[new Date(Date.UTC(2027, i, 1)).getUTCDay()], work };
});
const totalWork = months.reduce((s, m) => s + m.work, 0);
---
<GuideLayout slug="new-year-2027">
  <Countdown target="2027-01-01" label="باقي على رأس السنة 2027" today="سنة سعيدة. اليوم أول يوم من 2027" done="أهلاً بسنة 2027" note="الجمعة 1 يناير 2027. والعدّاد يحسب بتاريخ جهازك." />
  <AddToCalendar title="رأس السنة الميلادية 2027" dates={["2027-01-01"]} details="الجمعة 1 يناير 2027. العدّاد على hasibcalc.com/guides/new-year-2027/" file="new-year-2027" />

  <h2>الخلاصة</h2>
  <p>تبدأ السنة الميلادية 2027 يوم <strong>الجمعة 1 يناير 2027</strong>. وهي سنة عادية من 365 يوماً، لأن السنة الكبيسة القادمة 2028.</p>

  <h2>أهم مواعيد 2027</h2>
  <p>هذه أبرز المناسبات المتوقعة في السنة الجديدة، والمواعيد الهجرية بحسب تقويم أم القرى، وقد تختلف يوماً برؤية الهلال:</p>
  <div class="scroll-x"><table>
    <thead><tr><th>المناسبة</th><th>التاريخ المتوقع</th></tr></thead>
    <tbody>
      <tr><td>رأس السنة الميلادية</td><td>الجمعة 1 يناير 2027</td></tr>
      <tr><td>أول رمضان 1448</td><td>الاثنين 8 فبراير 2027</td></tr>
      <tr><td>عيد الفطر</td><td>الثلاثاء 9 مارس 2027</td></tr>
      <tr><td>يوم عرفة</td><td>السبت 15 مايو 2027</td></tr>
      <tr><td>عيد الأضحى</td><td>الأحد 16 مايو 2027</td></tr>
      <tr><td>رأس السنة الهجرية 1449</td><td>الأحد 6 يونيو 2027</td></tr>
    </tbody>
  </table></div>
  <div class="cta"><p>كم باقي على رمضان؟</p><a href="/guides/ramadan-1448/">عدّاد رمضان 1448 ←</a></div>

  <h2>أشهر 2027: عدد الأيام وأول يوم وأيام العمل</h2>
  <p>أيام العمل هنا من الاثنين إلى الجمعة، كأسبوع العمل في الجهات الاتحادية بالإمارات، وقبل خصم العطل الرسمية:</p>
  <div class="scroll-x"><table>
    <thead><tr><th>الشهر</th><th>عدد الأيام</th><th>يبدأ يوم</th><th>أيام العمل</th></tr></thead>
    <tbody>{months.map((m) => <tr><td>{m.name}</td><td class="num">{m.n}</td><td>{m.first}</td><td class="num">{m.work}</td></tr>)}</tbody>
  </table></div>
  <p>مجموع أيام العمل في 2027 من الاثنين إلى الجمعة: <strong class="num">{totalWork}</strong> يوماً قبل العطل الرسمية.</p>

  <h2>كيف تعدّ الأيام الباقية بنفسك؟</h2>
  <p>اطرح تاريخ اليوم من 1 يناير 2027، أو استخدم <a href="/days-between/">حاسبة الأيام بين تاريخين</a> واختر «بدون اليوم الأخير». ولمعرفة التاريخ الهجري لأي يوم من السنة الجديدة استخدم <a href="/hijri/">حاسبة التاريخ الهجري</a>.</p>

  <h2>هل 2027 سنة كبيسة؟</h2>
  <p>لا. السنة الكبيسة تقبل القسمة على 4، و2027 لا تقبلها، ففبراير 2027 فيه 28 يوماً. السنة الكبيسة التالية 2028، وفيها 29 فبراير.</p>

  <Faq title="أسئلة شائعة" items={[
    { q: "كم يوماً باقي على 2027؟", a: "العدّاد أعلى الصفحة يعرض العدد بحسب تاريخ جهازك، حتى الجمعة 1 يناير 2027." },
    { q: "كم عدد أيام سنة 2027؟", a: "365 يوماً، لأنها ليست سنة كبيسة." },
    { q: "متى تبدأ السنة الهجرية 1449؟", a: "يوم الأحد 6 يونيو 2027 بحسب تقويم أم القرى، وقد يختلف يوماً." },
    { q: "هل رأس السنة إجازة رسمية في الإمارات؟", a: "نعم، رأس السنة الميلادية يوم إجازة رسمي واحد في قائمة العطل الرسمية للقطاعين العام والخاص، ويوافق في 2027 يوم الجمعة 1 يناير." },
    { q: "ما التاريخ الهجري لأول يوم في 2027؟", a: "الجمعة 1 يناير 2027 يوافق 23 رجب 1448 هـ بحسب تقويم أم القرى." },
    { q: "كم يوم عمل في 2027؟", a: `${totalWork} يوماً من الاثنين إلى الجمعة قبل خصم العطل الرسمية. اطرح منها أيام العطل التي تعلنها جهة عملك.` },
  ]} />

  <h2>المصادر</h2>
  <ul class="sources">
    <li><a href="https://u.ae/ar/information-and-services/public-holidays-and-religious-affairs/public-holidays" rel="noopener" target="_blank">البوابة الرسمية لحكومة الإمارات: العطل الرسمية</a></li>
    <li>المواعيد الهجرية محسوبة بتقويم أم القرى في <a href="/hijri/">حاسبة التاريخ الهجري</a>، والإعلان الرسمي قد يختلف يوماً برؤية الهلال.</li>
  </ul>
</GuideLayout>
